---
/**
 * The lead-magnet offer on a blog post.
 *
 * Captures an email, posts it to /api/lead (which forwards to the CRM tagged
 * `magnet:<slug>`), and then HANDS OVER THE FILE immediately rather than
 * promising to email it. That matters for two reasons: the site has no working
 * outbound email, and a download the visitor gets in the same breath converts
 * better than one they have to go and find in an inbox.
 *
 * The capture is deliberately a single field. Every extra field on a magnet
 * form costs completions, and the CRM already gets the article they were
 * reading, so a name adds little.
 *
 * Renders nothing unless a magnet resolves AND it has a file. A magnet with no
 * file is an offer that cannot be fulfilled, which is exactly the state the
 * demo page was in, so it is treated as not configured.
 */
import { CONSENT_TEXT } from "@/content/copy/consent";

interface Props {
  magnet: {
    slug: string;
    title: string;
    description?: string;
    bullets: string[];
    file?: string;
    ctaLabel: string;
    image?: string;
    successBody?: string;
  };
  /** Article slug, so the CRM shows which post produced the lead. */
  postSlug?: string;
}

const { magnet, postSlug } = Astro.props;
const usable = Boolean(magnet?.file);
---

{usable && (
  <aside class="magnet" data-magnet data-slug={magnet.slug} data-file={magnet.file} data-post={postSlug}>
    <div class="magnet-body">
      <span class="magnet-kicker">Free download</span>
      <h2>{magnet.title}</h2>
      {magnet.description && <p class="magnet-desc">{magnet.description}</p>}

      {magnet.bullets.length > 0 && (
        <ul class="magnet-list">
          {magnet.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}

      <form class="magnet-form" data-magnet-form novalidate>
        <label class="sr-only" for={`magnet-email-${magnet.slug}`}>Email address</label>
        <input
          id={`magnet-email-${magnet.slug}`}
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
        />
        <button type="submit">{magnet.ctaLabel}</button>
      </form>

      <p class="magnet-consent">{CONSENT_TEXT}</p>
      <p class="magnet-error" data-magnet-error hidden role="alert"></p>
    </div>

    {magnet.image && (
      <div class="magnet-art"><img src={magnet.image} alt="" width="600" height="750" loading="lazy" decoding="async" /></div>
    )}

    {/* Swapped in after a successful capture. */}
    <div class="magnet-done" data-magnet-done hidden>
      <h2>Here it is.</h2>
      <p>{magnet.successBody ?? "Your download should start automatically. If it does not, use the link below."}</p>
      <a class="magnet-dl" data-magnet-download href={magnet.file} download>Download {magnet.title}</a>
    </div>
  </aside>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-magnet]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-magnet-form]");
    const done = root.querySelector<HTMLElement>("[data-magnet-done]");
    const body = root.querySelector<HTMLElement>(".magnet-body");
    const err = root.querySelector<HTMLElement>("[data-magnet-error]");
    const file = root.dataset.file;
    if (!form || !done || !body || !file) return;

    const fail = (msg: string) => {
      if (!err) return;
      err.textContent = msg;
      err.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="email"]');
      const button = form.querySelector<HTMLButtonElement>("button");
      if (!input || !input.value || !input.checkValidity()) {
        fail("Please enter a valid email address.");
        input?.focus();
        return;
      }
      if (err) err.hidden = true;
      if (button) { button.disabled = true; button.textContent = "Sending..."; }

      try {
        const res = await fetch("/api/lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            email: input.value,
            source: `magnet:${root.dataset.slug}`,
            magnet: root.dataset.slug,
            tags: `src:magnet,magnet:${root.dataset.slug}`,
            page: root.dataset.post ? `/blog/${root.dataset.post}` : location.pathname,
            notes: `Downloaded "${root.dataset.slug}"`,
          }),
        });

        // The endpoint answers 502 when no destination accepted the lead. The
        // visitor still gets the file: they kept their side of the exchange,
        // and withholding it would punish them for our outage.
        if (!res.ok) console.error("[magnet] capture failed", res.status);
      } catch (e) {
        console.error("[magnet] capture error", e);
      }

      body.hidden = true;
      done.hidden = false;
      // Start the download without navigating away from the article.
      const a = done.querySelector<HTMLAnchorElement>("[data-magnet-download]");
      a?.click();
    });
  });
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .magnet {
    display: grid; grid-template-columns: 1fr auto; gap: 1.75rem; align-items: center;
    border: 1px solid var(--theme-border, rgba(255, 255, 255, 0.16));
    border-radius: var(--radius-lg, 0.75rem);
    padding: 1.75rem; margin: 3rem 0;
    background: color-mix(in srgb, var(--color-brand-secondary, #2fa8b5) 10%, transparent);
  }
  @media (max-width: 720px) { .magnet { grid-template-columns: 1fr; } }

  .magnet-kicker {
    display: inline-block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-primary); margin-bottom: 0.5rem;
  }
  .magnet h2 { margin: 0 0 0.5rem; font-size: 1.375rem; line-height: 1.25; }
  .magnet-desc { margin: 0 0 1rem; color: var(--theme-fg-muted, rgba(255, 255, 255, 0.78)); }

  .magnet-list { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: 0.375rem; }
  .magnet-list li { position: relative; padding-left: 1.25rem; font-size: 0.9375rem; }
  .magnet-list li::before { content: "✓"; position: absolute; left: 0; color: var(--color-primary); font-weight: 700; }

  .magnet-form { display: flex; gap: 0.625rem; flex-wrap: wrap; }
  .magnet-form input {
    flex: 1 1 15rem; min-width: 0; padding: 0.7rem 0.9rem;
    border: 1px solid var(--theme-border, rgba(255, 255, 255, 0.22));
    border-radius: var(--radius-md, 0.5rem);
    background: rgba(255, 255, 255, 0.06); color: inherit; font: inherit;
  }
  .magnet-form input::placeholder { color: var(--theme-fg-subtle, rgba(255, 255, 255, 0.45)); }
  .magnet-form button {
    padding: 0.7rem 1.25rem; border: 0; border-radius: var(--radius-md, 0.5rem);
    background: var(--color-primary); color: #fff; font: inherit; font-weight: 600; cursor: pointer;
  }
  .magnet-form button:hover { opacity: 0.92; }
  .magnet-form button:disabled { opacity: 0.6; cursor: default; }

  .magnet-consent {
    font-size: 0.6875rem; line-height: 1.45; margin: 0.75rem 0 0;
    color: var(--theme-fg-subtle, rgba(255, 255, 255, 0.55));
  }
  .magnet-error { margin: 0.625rem 0 0; font-size: 0.875rem; color: #ff9d87; }

  .magnet-art img { display: block; width: 180px; height: auto; border-radius: var(--radius-md, 0.5rem); }
  @media (max-width: 720px) { .magnet-art { display: none; } }

  .magnet-done { grid-column: 1 / -1; }
  .magnet-done h2 { margin: 0 0 0.5rem; }
  .magnet-done p { margin: 0 0 1rem; color: var(--theme-fg-muted, rgba(255, 255, 255, 0.78)); }
  .magnet-dl {
    display: inline-block; padding: 0.7rem 1.25rem; border-radius: var(--radius-md, 0.5rem);
    background: var(--color-primary); color: #fff; font-weight: 600; text-decoration: none;
  }
</style>
