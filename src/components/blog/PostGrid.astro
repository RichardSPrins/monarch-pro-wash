---
/**
 * The blog listing body: an optional featured lead, a card grid, and pagination.
 *
 * Shared by /blog and /blog/page/[page] so the two cannot drift apart. The lead
 * card only appears on page one, because a "featured" post pinned to the top of
 * page four would be odd.
 */
import { Button } from "@/components/elements/button";
import type { PostCard } from "@/lib/blog";

interface Props {
  posts: PostCard[];
  /** 1-based. */
  page: number;
  /** From the loader. There is no total count by design, so we page blind. */
  hasMore: boolean;
  /** Shown above the grid on page one only. */
  lead?: PostCard | null;
  /** "/blog" or "/blog/category/pricing", so paging stays inside a filter. */
  basePath?: string;
}

const { posts, page, hasMore, lead = null, basePath = "/blog" } = Astro.props;

const fmt = (d: Date) =>
  d && !isNaN(d.getTime())
    ? d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
    : undefined;

const hrefFor = (n: number) => (n <= 1 ? basePath : `${basePath}/page/${n}`);

---

{posts.length === 0 && !lead && <p class="empty">No posts yet. Check back soon.</p>}

{lead && (
  <a class="lead" href={`/blog/${lead.slug}`}>
    {lead.cover && <img src={lead.cover} alt={lead.coverAlt ?? ""} width="1200" height="630" loading="eager" decoding="async" />}
    <div>
      <span class="cat">{lead.featured ? "Featured" : lead.category}</span>
      <h2>{lead.title}</h2>
      {lead.description && <p>{lead.description}</p>}
      <span class="meta">{[lead.author, fmt(lead.date)].filter(Boolean).join(" · ")}</span>
    </div>
  </a>
)}

{posts.length > 0 && (
  <ul class="grid">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.slug}`}>
          {p.cover && <img src={p.cover} alt={p.coverAlt ?? ""} width="1200" height="630" loading="lazy" decoding="async" />}
          <div class="card-body">
            {p.category && <span class="cat sm">{p.category}</span>}
            <h3>{p.title}</h3>
            {p.description && <p>{p.description}</p>}
            <span class="meta">{fmt(p.date)}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}

{(page > 1 || hasMore) && (
  <nav class="pager" aria-label="Blog pages">
    <a class={`pg ${page <= 1 ? "off" : ""}`} href={hrefFor(page - 1)} rel="prev" aria-disabled={page <= 1}>
      Previous
    </a>
    <span class="pos">Page {page}</span>
    <a class={`pg ${!hasMore ? "off" : ""}`} href={hrefFor(page + 1)} rel="next" aria-disabled={!hasMore}>
      Next
    </a>
  </nav>
)}

<aside class="bi-cta">
  <h2>Rather just have it done?</h2>
  <p>Free quote, a clear price up front, and the owner doing the work. New customers get 10% off their first service.</p>
  <Button variant="primary" href="/contact">Get My Free Quote</Button>
</aside>

<style>
  a { text-decoration: none; color: inherit; }
  img { display: block; width: 100%; height: auto; border-radius: var(--radius-lg, 0.75rem); }
  .empty { color: var(--theme-fg-muted, rgba(255,255,255,0.7)); }


  .cat {
    display: inline-block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-primary);
    border: 1px solid currentColor; border-radius: 999px; padding: 0.25rem 0.625rem; margin-bottom: 0.75rem;
  }
  .cat.sm { font-size: 0.625rem; margin-bottom: 0.5rem; }

  .lead { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.75rem; align-items: center; margin-bottom: 2.5rem; }
  .lead h2 { margin: 0 0 0.625rem; font-size: 1.75rem; line-height: 1.2; }
  .lead p { margin: 0 0 0.875rem; color: var(--theme-fg-muted, rgba(255,255,255,0.72)); line-height: 1.6; }
  .lead:hover h2 { color: var(--color-primary); }
  @media (max-width: 820px) { .lead { grid-template-columns: 1fr; gap: 1rem; } }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  .card-body { padding-top: 0.875rem; }
  .grid h3 { margin: 0 0 0.5rem; font-size: 1.0625rem; line-height: 1.35; }
  .grid p {
    margin: 0 0 0.625rem; font-size: 0.9375rem; line-height: 1.55;
    color: var(--theme-fg-muted, rgba(255,255,255,0.68));
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .grid a:hover h3 { color: var(--color-primary); }
  .meta { font-size: 0.8125rem; color: var(--theme-fg-subtle, rgba(255,255,255,0.5)); }

  .pager { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 3rem; flex-wrap: wrap; }
  .pager .pos { font-size: 0.875rem; color: var(--theme-fg-muted, rgba(255,255,255,0.65)); }
  .pager a {
    display: grid; place-items: center; min-width: 2.25rem; height: 2.25rem; padding: 0 0.625rem;
    border: 1px solid var(--theme-border, rgba(255,255,255,0.16)); border-radius: 0.5rem; font-size: 0.875rem;
  }
  .pager a:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .pager .off { opacity: 0.35; pointer-events: none; }

  .bi-cta {
    margin-top: 3.5rem; padding: 2rem; text-align: center;
    border: 1px solid var(--theme-border, rgba(255,255,255,0.14));
    border-radius: var(--radius-lg, 0.75rem);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  .bi-cta h2 { margin: 0 0 0.5rem; font-size: 1.375rem; }
  .bi-cta p { margin: 0 0 1.25rem; color: var(--theme-fg-muted, rgba(255,255,255,0.75)); }
</style>
