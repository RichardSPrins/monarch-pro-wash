---
import Logo from "@/components/layout/Logo.astro";
import { getBusinessData } from "@/lib/utils";
import NavItem from "@/components/layout/NavItem.astro";
import type { NavNode } from "@/lib/utils";

interface Props {
  navItems: NavNode[];
}

const { navItems } = Astro.props;
const business = await getBusinessData();
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-bg border-b border-border transition-shadow duration-300"
  data-header
>
  <!-- Main nav (single row, prominent conversion cluster) -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 font-bold text-xl text-fg hover:text-primary transition-colors shrink-0">
        <Logo business={business} eager />
      </a>

      <!-- Desktop nav (center) -->
      <nav class="hidden lg:flex items-center flex-1 justify-center" aria-label="Main navigation">
        <ul class="flex items-center gap-1 list-none m-0 p-0">
          {navItems.map((item) => <NavItem node={item} />)}
        </ul>
      </nav>

      <!-- Desktop conversion cluster (emphasized) -->
      <div class="hidden lg:flex items-center gap-5 shrink-0">
        {business.phone && (
          <a
            href={`tel:${business.phone}`}
            class="group flex items-center gap-3 text-fg hover:text-primary transition-colors"
          >
            <span class="flex items-center justify-center w-11 h-11 rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-fg-on-primary transition-colors">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </span>
            <span class="flex flex-col leading-tight">
              <span class="text-xs font-medium uppercase tracking-wide text-fg/60">Call now</span>
              <span class="text-lg font-bold">{business.phone}</span>
            </span>
          </a>
        )}
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-7 py-3.5 bg-primary text-fg-on-primary text-base font-bold rounded-lg shadow-sm hover:bg-primary-light transition-colors"
        >
          Get a Free Quote
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        class="lg:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-bg-muted transition-colors"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-nav-toggle
      >
        <span class="w-6 h-0.5 bg-fg transition-all duration-300" data-hamburger-line></span>
        <span class="w-6 h-0.5 bg-fg transition-all duration-300" data-hamburger-line></span>
        <span class="w-6 h-0.5 bg-fg transition-all duration-300" data-hamburger-line></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-border bg-bg"
    data-nav-menu
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4">
      <ul class="flex flex-col gap-1 list-none m-0 p-0" id="mobile-nav-list">
        {navItems.map((item) => <NavItem node={item} />)}
      </ul>
      <!-- Prominent conversion cluster (mobile) -->
      <div class="mt-6 pt-6 border-t border-border flex flex-col gap-3">
        {business.phone && (
          <a
            href={`tel:${business.phone}`}
            class="flex items-center justify-center gap-3 w-full px-5 py-3.5 border-2 border-primary rounded-lg text-primary hover:bg-primary hover:text-fg-on-primary transition-colors"
          >
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span class="flex flex-col items-start leading-tight">
              <span class="text-xs font-medium uppercase tracking-wide opacity-70">Call now</span>
              <span class="text-base font-bold">{business.phone}</span>
            </span>
          </a>
        )}
        <a
          href="/contact"
          class="flex items-center justify-center w-full px-5 py-3.5 bg-primary text-fg-on-primary text-base font-bold rounded-lg hover:bg-primary-light transition-colors"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </div>
</header>

<script>import "@/lib/nav.js";</script>
