---
import Logo from "@/components/layout/Logo.astro";
import { getBusinessData, getFooterNav } from "@/lib/utils";

const business = await getBusinessData();
const year = new Date().getFullYear();

// Footer columns = groups of the native `footer` menu; legal from `footer-legal`.
const { groups, legal } = await getFooterNav();
---

<footer>
  <!-- CTA band -->
  <div class="bg-primary text-fg-on-primary">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
      <div
        class="flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left"
      >
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-fg-on-primary">Ready to Get Started?</h2>
          <p class="mt-2 text-fg-on-primary/80 max-w-xl">
            Get a free, no-obligation quote today and see how we can help.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 bg-bg text-fg text-sm font-semibold rounded-lg hover:bg-bg-muted transition-colors"
          >
            Get a Free Quote
          </a>
          {
            business.phone && (
              <a
                href={`tel:${business.phone}`}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-fg-on-primary/40 text-fg-on-primary text-sm font-semibold rounded-lg hover:bg-fg-on-primary/10 transition-colors"
              >
                <svg
                  class="w-4 h-4"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Lower area -->
  <div class="bg-bg-inverse text-fg-inverse">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] gap-10">
        <!-- Brand / contact column -->
        <div>
          <a
            href="/"
            class="inline-block font-bold text-xl text-fg-inverse hover:text-accent transition-colors mb-4"
          >
            <Logo business={business} />
          </a>
          {
            business.tagline && (
              <p class="text-fg-inverse/60 text-sm leading-relaxed mb-6">
                {business.tagline}
              </p>
            )
          }
          <div class="flex flex-col gap-3 text-sm">
            {
              business.phone && (
                <a
                  href={`tel:${business.phone}`}
                  class="flex items-center gap-2 text-fg-inverse/70 hover:text-fg-inverse transition-colors"
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  {business.phone}
                </a>
              )
            }
            {
              business.email && (
                <a
                  href={`mailto:${business.email}`}
                  class="flex items-center gap-2 text-fg-inverse/70 hover:text-fg-inverse transition-colors"
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,12 2,6" />
                  </svg>
                  {business.email}
                </a>
              )
            }
            {
              business.address && (
                <address class="flex items-start gap-2 text-fg-inverse/70 not-italic">
                  <svg
                    class="w-4 h-4 shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  <span>
                    {business.address}, {business.city}, {business.state}{" "}
                    {business.zip}
                  </span>
                </address>
              )
            }
          </div>
        </div>

        <!-- Nav columns — one per group in the native `footer` menu -->
        {
          groups.map((group) => (
            <div>
              <h3 class="text-sm font-semibold text-fg-inverse uppercase tracking-wider mb-4">
                {group.label}
              </h3>
              <ul class="flex flex-col gap-2.5 list-none m-0 p-0">
                {(group.children ?? []).map((item) => (
                  <li>
                    {item.href ? (
                      <a
                        href={item.href}
                        class="text-sm text-fg-inverse/60 hover:text-fg-inverse transition-colors"
                      >
                        {item.label}
                      </a>
                    ) : (
                      <span class="text-sm text-fg-inverse/60">{item.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-fg-inverse/10">
      <div
        class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4"
      >
        <p class="text-xs text-fg-inverse/40">
          &copy; {year}
          {business.businessName}. All rights reserved.
        </p>
        {
          legal.length > 0 && (
            <nav class="flex flex-wrap items-center gap-x-4 gap-y-1">
              {legal
                .filter((l) => l.href)
                .map((l) => (
                  <a
                    href={l.href}
                    class="text-xs text-fg-inverse/40 hover:text-fg-inverse transition-colors"
                  >
                    {l.label}
                  </a>
                ))}
            </nav>
          )
        }
        <p class="text-xs text-fg-inverse/40">
          Built by{" "}
          <a
            href="https://extensibl.com"
            target="_blank"
            rel="noopener"
            class="text-fg-inverse/60 hover:text-fg-inverse transition-colors"
          >
            Velocity Web Studio
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
