---
import Logo from "@/components/layout/Logo.astro";
import { getBusinessData } from "@/lib/utils";
import NavItem from "@/components/layout/NavItem.astro";
import type { NavNode } from "@/lib/utils";

interface Props {
  navItems: NavNode[];
}

const { navItems } = Astro.props;
const business = await getBusinessData();
---

<!--
  Transparent overlay header.
  IMPORTANT: This header overlays the first section, so it renders NO spacer div.
  The first section on any page using this header MUST be a full-height hero
  (the hero sits under the transparent bar by design).
-->
<header
  data-header
  data-transparent
  class="on-dark fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <!-- Main nav (single row) -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="header-logo flex items-center gap-2 font-bold text-xl text-fg-inverse transition-colors shrink-0">
        <Logo business={business} eager />
      </a>

      <!-- Desktop nav (center) -->
      <nav class="hidden lg:flex items-center flex-1 justify-center" aria-label="Main navigation">
        <ul class="flex items-center gap-1 list-none m-0 p-0">
          {navItems.map((item) => <NavItem node={item} />)}
        </ul>
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-4 shrink-0">
        {business.phone && (
          <a
            href={`tel:${business.phone}`}
            class="header-phone text-sm font-semibold text-fg-inverse transition-colors"
          >
            {business.phone}
          </a>
        )}
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-primary text-fg-on-primary text-sm font-semibold rounded-lg hover:bg-primary-light transition-colors"
        >
          Get a Free Quote
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        class="lg:hidden flex flex-col gap-1.5 p-2 rounded-lg transition-colors"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-nav-toggle
      >
        <span class="hamburger-line w-6 h-0.5 bg-fg-inverse transition-all duration-300" data-hamburger-line></span>
        <span class="hamburger-line w-6 h-0.5 bg-fg-inverse transition-all duration-300" data-hamburger-line></span>
        <span class="hamburger-line w-6 h-0.5 bg-fg-inverse transition-all duration-300" data-hamburger-line></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-border bg-bg"
    data-nav-menu
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4">
      <ul class="flex flex-col gap-1 list-none m-0 p-0" id="mobile-nav-list">
        {navItems.map((item) => <NavItem node={item} />)}
      </ul>
      <div class="mt-6 pt-6 border-t border-border flex flex-col gap-3">
        {business.phone && (
          <a
            href={`tel:${business.phone}`}
            class="flex items-center justify-center gap-2 w-full px-5 py-2.5 border border-border rounded-lg text-sm font-semibold text-fg hover:bg-bg-muted transition-colors"
          >
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            {business.phone}
          </a>
        )}
        <a
          href="/contact"
          class="flex items-center justify-center w-full px-5 py-2.5 bg-primary text-fg-on-primary text-sm font-semibold rounded-lg hover:bg-primary-light transition-colors"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </div>
</header>

<!--
  No spacer div: the header overlays the hero on purpose.
  The scrolled state is toggled by the inline script below via a top sentinel.
-->
<span id="header-sentinel" aria-hidden="true" class="absolute top-0 left-0 h-5 w-px pointer-events-none"></span>

<style>
  /* Transparent-over-hero default state uses light text (set in markup).
     Once .scrolled is added, switch to a solid bar with shadow + dark text. */
  header[data-transparent].scrolled {
    background-color: var(--color-bg);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  }
  header[data-transparent].scrolled .header-logo,
  header[data-transparent].scrolled .header-phone {
    color: var(--color-fg);
  }
  header[data-transparent].scrolled .hamburger-line {
    background-color: var(--color-fg);
  }
</style>

<script>
  const header = document.querySelector("header[data-transparent]");
  const sentinel = document.getElementById("header-sentinel");
  if (header && sentinel && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("scrolled", !entry.isIntersecting);
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);
  } else if (header) {
    // Fallback: toggle on scroll past 20px.
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 20);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<script>import "@/lib/nav.js";</script>
