---
import { getBusinessData, getFooterNav } from "@/lib/utils";
import Logo from "@/components/layout/Logo.astro";

/**
 * footer:brandmark — the brand name set OVERSIZED as a gradient watermark
 * spanning the footer, with nav groups + contact above it. Big-lettering brand
 * moment (Baird / Shattered Vision energy).
 */
const business = await getBusinessData();
const year = new Date().getFullYear();
const { groups, legal } = await getFooterNav();
const s = (business as any).social ?? {};
const addr = [business.address, [business.city, business.state].filter(Boolean).join(", "), business.zip].filter(Boolean).join(" · ");
// Just the first word of the brand (e.g. "MONARCH"), stretched full-bleed below.
const mark = (business.businessName ?? "").split(" ")[0].toUpperCase();
---

<footer class="fbm bg-bg-inverse text-fg-inverse relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-6 relative z-10">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div class="flex flex-col gap-4">
        <a href="/" class="no-underline w-fit" aria-label={business.businessName}>
          <Logo business={business} class="h-auto w-auto max-h-14 max-w-[220px] object-contain" />
        </a>
        {business.tagline && <p class="text-fg-inverse/60 text-sm leading-relaxed max-w-xs m-0">{business.tagline}</p>}
        <div class="flex flex-col gap-1.5 text-sm text-fg-inverse/75">
          {business.phone && <a href={`tel:${business.phone}`} class="hover:text-fg-inverse no-underline w-fit">{business.phone}</a>}
          {business.email && <a href={`mailto:${business.email}`} class="hover:text-fg-inverse no-underline w-fit">{business.email}</a>}
          {addr && <span>{addr}</span>}
        </div>
        <div class="flex gap-2 mt-1">
          {s.facebook && <a href={s.facebook} aria-label="Facebook" class="fbm-soc"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M24 12.07C24 5.44 18.63.07 12 .07S0 5.44 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z"/></svg></a>}
          {s.instagram && <a href={s.instagram} aria-label="Instagram" class="fbm-soc"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32A6.16 6.16 0 0012 5.84zm0 10.16a4 4 0 110-8 4 4 0 010 8zm6.41-11.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg></a>}
          {s.youtube && <a href={s.youtube} aria-label="YouTube" class="fbm-soc"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 00.5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 002.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 002.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg></a>}
        </div>
      </div>

      {groups.slice(0, 3).map((g) => (
        <nav class="flex flex-col gap-2.5">
          <h3 class="text-xs font-bold uppercase tracking-widest text-fg-inverse/45 m-0">{g.label}</h3>
          <ul class="flex flex-col gap-2 list-none m-0 p-0">
            {(g.children ?? []).slice(0, 6).map((c) => (
              <li><a href={c.href ?? "#"} class="text-sm text-fg-inverse/75 hover:text-fg-inverse no-underline">{c.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <svg class="fbm-mark" viewBox="0 0 1200 210" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <defs>
      <linearGradient id="fbmGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.16" />
        <stop offset="92%" stop-color="#ffffff" stop-opacity="0.02" />
      </linearGradient>
    </defs>
    <text x="600" y="180" text-anchor="middle" textLength="1184" lengthAdjust="spacingAndGlyphs" fill="url(#fbmGrad)" font-size="200" font-weight="900" style="letter-spacing:-0.02em">{mark}</text>
  </svg>

  <div class="relative z-10 border-t border-white/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5 flex flex-wrap items-center justify-between gap-3 text-xs text-fg-inverse/55">
      <span>© {year} {business.businessName}. All rights reserved.</span>
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        {legal.filter((l) => l.href).map((l) => <a href={l.href} class="hover:text-fg-inverse no-underline">{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>

<style>
  .fbm-soc { width: 2rem; height: 2rem; border-radius: 999px; display: grid; place-items: center; color: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.16); transition: background 0.18s, color 0.18s, border-color 0.18s; }
  .fbm-soc:hover { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .fbm-mark { display: block; width: 100%; margin-top: -0.5rem; user-select: none; pointer-events: none; }
</style>
