---
import { Image } from "astro:assets";
import { getBusinessData, getFooterNav } from "@/lib/utils";
import Logo from "@/components/layout/Logo.astro";
import footerMotif from "@/assets/images/footer-motif.png";

/**
 * footer:brandmark — a full-bleed brand motif spanning the footer, with nav
 * groups + contact above it. Big brand moment at the close of every page.
 *
 * The mark used to be the brand's first word set as oversized SVG <text>. It is
 * now the Monarch motif artwork (wand, spray, rooflines) — same slot, same
 * full-bleed treatment, but it says what the business does rather than just
 * repeating the name already shown in the logo directly above it.
 */
const business = await getBusinessData();
const year = new Date().getFullYear();
const { groups, legal } = await getFooterNav();
const s = (business as any).social ?? {};
const addr = [business.address, [business.city, business.state].filter(Boolean).join(", "), business.zip].filter(Boolean).join(" · ");
---

<footer class="fbm bg-bg-inverse text-fg-inverse relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-6 relative z-10">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
      <div class="flex flex-col gap-4">
        <a href="/" class="no-underline w-fit" aria-label={business.businessName}>
          <Logo business={business} class="h-auto w-auto max-h-14 max-w-[220px] object-contain" />
        </a>
        {business.tagline && <p class="text-fg-inverse/60 text-sm leading-relaxed max-w-xs m-0">{business.tagline}</p>}
        <div class="flex flex-col gap-1.5 text-sm text-fg-inverse/75">
          {business.phone && <a href={`tel:${business.phone}`} class="fbm-link no-underline w-fit">{business.phone}</a>}
          {business.email && <a href={`mailto:${business.email}`} class="fbm-link no-underline w-fit">{business.email}</a>}
          {addr && <span>{addr}</span>}
        </div>
        <div class="flex gap-2 mt-1">
          {s.facebook && <a href={s.facebook} aria-label="Facebook" class="fbm-soc"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M24 12.07C24 5.44 18.63.07 12 .07S0 5.44 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z"/></svg></a>}
          {s.instagram && <a href={s.instagram} aria-label="Instagram" class="fbm-soc"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32A6.16 6.16 0 0012 5.84zm0 10.16a4 4 0 110-8 4 4 0 010 8zm6.41-11.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg></a>}
          {s.youtube && <a href={s.youtube} aria-label="YouTube" class="fbm-soc"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 00.5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 002.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 002.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg></a>}
        </div>

        <div class="mt-3 flex flex-col gap-1.5 text-xs text-fg-inverse/50">
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            {legal.filter((l) => l.href).map((l) => <a href={l.href} class="fbm-link no-underline">{l.label}</a>)}
          </div>
          <span>© {year} {business.businessName}. All rights reserved.</span>
        </div>
      </div>

      {/* Four groups: Services, Service Areas, Company, Resources. Raising this
          cap means the grid below has to make room for a fourth column too. */}
      {groups.slice(0, 4).map((g) => (
        <nav class="flex flex-col gap-2.5">
          <h3 class="text-xs font-bold uppercase tracking-widest text-fg-inverse/45 m-0">{g.label}</h3>
          <ul class="flex flex-col gap-2 list-none m-0 p-0">
            {(g.children ?? []).slice(0, 6).map((c) => (
              <li><a href={c.href ?? "#"} class="fbm-link text-sm text-fg-inverse/75 no-underline">{c.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="fbm-motif" aria-hidden="true">
    <Image
      src={footerMotif}
      alt=""
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>

</footer>

<style>
  /* Footer links answer in the brand orange on hover, keyboard focus and while
     being pressed, so an interaction is visibly acknowledged. Previously they
     brightened to white, which on a navy footer reads as almost no change at
     all. :focus-visible is included so keyboard users get the same signal, and
     :active gives a distinct pressed state on touch, where there is no hover. */
  .fbm-link {
    transition: color 0.15s ease;
  }
  .fbm-link:hover,
  .fbm-link:focus-visible {
    color: var(--color-primary);
  }
  .fbm-link:active {
    color: var(--color-primary-light, var(--color-primary));
  }
  .fbm-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .fbm-soc { width: 2rem; height: 2rem; border-radius: 999px; display: grid; place-items: center; color: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.16); transition: background 0.18s, color 0.18s, border-color 0.18s; }
  .fbm-soc:hover { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  /* The source PNG is 1536x1024 but the illustration only occupies rows
     602-902 — the rest is flat sky above and below. The image generator can't
     output a 5:1 canvas, so the scene is drawn as a band inside a 3:2 frame
     and cropped here. The wrapper is sized to the artwork's own 1536:301 box
     and the image is pulled up by the empty space above it. Both offsets are
     percentages of the WRAPPER WIDTH (margin percentages always resolve
     against the containing block's inline size), so the crop holds at every
     viewport width:
       top padding  602 / 1536 = 39.193%
       artwork band 301 / 1536 = 19.596%  -> aspect-ratio 1536 / 301 (5.10:1)

     The illustration's sky is colour-matched to rgb(10,31,46) == the footer's
     --t-bg-inverse, so the top of the band dissolves into the footer with no
     seam. Re-match it if the artwork is ever replaced. */
  .fbm-motif { overflow: hidden; aspect-ratio: 1536 / 301; user-select: none; pointer-events: none; }
  .fbm-motif :global(img) { display: block; width: 100%; height: auto; margin-top: -39.193%; }
</style>
