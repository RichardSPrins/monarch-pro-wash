---
import Logo from "@/components/layout/Logo.astro";
import { getBusinessData, getFooterNav } from "@/lib/utils";
import { getHoursSettings } from "@/lib/content";

const business = await getBusinessData();
const year = new Date().getFullYear();

// Minimal footer: flatten the native `footer` menu into one row; legal below.
const { flat, legal } = await getFooterNav();
const links = flat.filter((l) => l.href).slice(0, 6);

const h = await getHoursSettings();
const hours = h[0]?.data.hours ?? [];

const fullAddress = [
  business.address,
  business.city,
  business.state,
  business.zip,
]
  .filter(Boolean)
  .join(", ");

const mapSrc = fullAddress
  ? `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`
  : null;
---

<footer class="bg-bg-inverse text-fg-inverse">
  <!-- Upper area: NAP + hours / map -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
      <!-- Left: brand, NAP, hours -->
      <div>
        <a
          href="/"
          class="inline-block font-bold text-xl text-fg-inverse hover:text-accent transition-colors mb-4"
        >
          <Logo business={business} />
        </a>
        {
          business.tagline && (
            <p class="text-fg-inverse/60 text-sm leading-relaxed mb-6">
              {business.tagline}
            </p>
          )
        }

        <!-- NAP -->
        <div class="flex flex-col gap-3 text-sm mb-8">
          {
            business.address && (
              <address class="flex items-start gap-2 text-fg-inverse/70 not-italic">
                <svg
                  class="w-4 h-4 shrink-0 mt-0.5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>
                  {business.address}, {business.city}, {business.state}{" "}
                  {business.zip}
                </span>
              </address>
            )
          }
          {
            business.phone && (
              <a
                href={`tel:${business.phone}`}
                class="flex items-center gap-2 text-fg-inverse/70 hover:text-fg-inverse transition-colors"
              >
                <svg
                  class="w-4 h-4 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )
          }
          {
            business.email && (
              <a
                href={`mailto:${business.email}`}
                class="flex items-center gap-2 text-fg-inverse/70 hover:text-fg-inverse transition-colors"
              >
                <svg
                  class="w-4 h-4 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,12 2,6" />
                </svg>
                {business.email}
              </a>
            )
          }
        </div>

        <!-- Business hours -->
        {
          hours.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-fg-inverse uppercase tracking-wider mb-4">
                Business Hours
              </h3>
              <dl class="flex flex-col gap-2 text-sm max-w-xs">
                {hours.map((entry) => (
                  <div class="flex items-center justify-between gap-4">
                    <dt class="text-fg-inverse/70">{entry.day}</dt>
                    <dd class="text-fg-inverse/60">
                      {entry.closedAllDay
                        ? "Closed"
                        : `${entry.open} – ${entry.close}`}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </div>

      <!-- Right: map embed -->
      {
        mapSrc && (
          <div class="rounded-xl overflow-hidden" style="min-height: 260px;">
            <iframe
              title={`Map of ${business.businessName}`}
              src={mapSrc}
              width="100%"
              height="100%"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              style="border: 0; min-height: 260px; display: block;"
              allowfullscreen
            />
          </div>
        )
      }
    </div>
  </div>

  <!-- Quick links row -->
  <div class="border-t border-fg-inverse/10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 list-none m-0 p-0">
        {
          links.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-fg-inverse/60 hover:text-fg-inverse transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-fg-inverse/10">
    <div
      class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-xs text-fg-inverse/40">
        &copy; {year}
        {business.businessName}. All rights reserved.
      </p>
      {
        legal.length > 0 && (
          <nav class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {legal
              .filter((l) => l.href)
              .map((l) => (
                <a
                  href={l.href}
                  class="text-xs text-fg-inverse/40 hover:text-fg-inverse transition-colors"
                >
                  {l.label}
                </a>
              ))}
          </nav>
        )
      }
      <p class="text-xs text-fg-inverse/40">
        Built by{" "}
        <a
          href="https://extensibl.com"
          target="_blank"
          rel="noopener"
          class="text-fg-inverse/60 hover:text-fg-inverse transition-colors"
        >
          Velocity Web Studio
        </a>
      </p>
    </div>
  </div>
</footer>
