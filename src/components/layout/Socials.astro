---
/**
 * Socials — renders social icon links from the site's configured URLs
 * (EmDash → Settings → Social Links, surfaced via getBusinessData().social).
 * Only platforms with a URL render. Styling is passed in so each header/footer
 * keeps its own look. Add a platform here ONCE and every consumer picks it up.
 */
export interface SocialLinks {
  facebook?: string;
  instagram?: string;
  youtube?: string;
  twitter?: string;
  linkedin?: string;
}

interface Props {
  social?: SocialLinks;
  /** wrapper element classes */
  class?: string;
  /** each <a> link classes */
  linkClass?: string;
  /** each <svg> icon classes */
  iconClass?: string;
}

const {
  social = {},
  class: wrapClass = "flex items-center gap-3",
  linkClass = "",
  iconClass = "w-4 h-4",
} = Astro.props;

type Platform = { key: keyof SocialLinks; label: string; mode: "fill" | "stroke"; inner: string };

const PLATFORMS: Platform[] = [
  { key: "facebook", label: "Facebook", mode: "fill",
    inner: `<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />` },
  { key: "instagram", label: "Instagram", mode: "stroke",
    inner: `<rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />` },
  { key: "youtube", label: "YouTube", mode: "stroke",
    inner: `<path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z" /><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" />` },
  { key: "twitter", label: "X", mode: "fill",
    inner: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />` },
  { key: "linkedin", label: "LinkedIn", mode: "fill",
    inner: `<path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.24 8h4.49v14H.24zM8.34 8h4.3v1.92h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V22h-4.49v-6.62c0-1.58-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.49V22H8.34z" />` },
];

const links = PLATFORMS.filter((p) => social[p.key]);
---

{
  links.length > 0 && (
    <div class={wrapClass}>
      {links.map((p) =>
        p.mode === "fill" ? (
          <a href={social[p.key]} target="_blank" rel="noopener" aria-label={p.label} class={linkClass}>
            <svg class={iconClass} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={p.inner} />
          </a>
        ) : (
          <a href={social[p.key]} target="_blank" rel="noopener" aria-label={p.label} class={linkClass}>
            <svg class={iconClass} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.inner} />
          </a>
        )
      )}
    </div>
  )
}
