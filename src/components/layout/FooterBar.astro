---
import Logo from "@/components/layout/Logo.astro";
import { getBusinessData, getFooterNav } from "@/lib/utils";

const business = await getBusinessData();
const year = new Date().getFullYear();

// Minimal footer: flatten the native `footer` menu into one row; legal below.
const { flat, legal } = await getFooterNav();
const links = flat.filter((l) => l.href).slice(0, 6);
---

<footer class="bg-bg-inverse text-fg-inverse">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-5">
    <div
      class="flex flex-col md:flex-row flex-wrap items-center justify-between gap-x-8 gap-y-4"
    >
      <!-- Business name (left) -->
      <a
        href="/"
        class="font-bold text-base text-fg-inverse hover:text-accent transition-colors shrink-0"
      >
        <Logo business={business} />
      </a>

      <!-- Quick links (center) -->
      <nav aria-label="Footer navigation" class="flex-1">
        <ul
          class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5 list-none m-0 p-0"
        >
          {
            links.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-fg-inverse/60 hover:text-fg-inverse transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Social + copyright (right) -->
      <div class="flex items-center gap-4 shrink-0">
        {
          (business.social?.facebook ||
            business.social?.instagram ||
            business.social?.youtube) && (
            <div class="flex items-center gap-2">
              {business.social?.facebook && (
                <a
                  href={business.social.facebook}
                  target="_blank"
                  rel="noopener"
                  aria-label="Facebook"
                  class="w-7 h-7 flex items-center justify-center rounded-md bg-fg-inverse/10 text-fg-inverse/60 hover:bg-fg-inverse/20 hover:text-fg-inverse transition-colors"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                  </svg>
                </a>
              )}
              {business.social?.instagram && (
                <a
                  href={business.social.instagram}
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
                  class="w-7 h-7 flex items-center justify-center rounded-md bg-fg-inverse/10 text-fg-inverse/60 hover:bg-fg-inverse/20 hover:text-fg-inverse transition-colors"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                </a>
              )}
              {business.social?.youtube && (
                <a
                  href={business.social.youtube}
                  target="_blank"
                  rel="noopener"
                  aria-label="YouTube"
                  class="w-7 h-7 flex items-center justify-center rounded-md bg-fg-inverse/10 text-fg-inverse/60 hover:bg-fg-inverse/20 hover:text-fg-inverse transition-colors"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z" />
                    <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" />
                  </svg>
                </a>
              )}
            </div>
          )
        }
        <p class="text-xs text-fg-inverse/40 whitespace-nowrap">
          &copy; {year}
          {business.businessName}
        </p>
      </div>
    </div>

    <!-- Legal + Built by Velocity Web Studio -->
    <div class="mt-4 pt-4 border-t border-fg-inverse/10 text-center">
      {
        legal.length > 0 && (
          <nav class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 mb-2">
            {legal
              .filter((l) => l.href)
              .map((l) => (
                <a
                  href={l.href}
                  class="text-xs text-fg-inverse/40 hover:text-fg-inverse transition-colors"
                >
                  {l.label}
                </a>
              ))}
          </nav>
        )
      }
      <p class="text-xs text-fg-inverse/40">
        Built by{" "}
        <a
          href="https://velocitywebstudio.com"
          target="_blank"
          rel="noopener"
          class="text-fg-inverse/60 hover:text-fg-inverse transition-colors"
        >
          Velocity Web Studio
        </a>
      </p>
    </div>
  </div>
</footer>
