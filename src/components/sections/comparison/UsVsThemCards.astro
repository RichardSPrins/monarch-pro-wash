---
import type { Eyebrow, ComparisonRow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    usLabel?: string;
    themLabel?: string;
    usTagline?: string;
    themTagline?: string;
    rows?: ComparisonRow[];
    ctas?: SectionCTA[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const usLabel = data?.usLabel ?? "Peak Roofing Co.";
const themLabel = data?.themLabel ?? "The Typical Contractor";
const rows = data?.rows ?? [];
const ctas = (data?.ctas?.length
  ? data.ctas
  : [data?.cta, data?.secondaryCta].filter(Boolean)) as SectionCTA[];
---

<section
  class:list={[
    "comparison-cards section-wrapper section-py",
    `theme-${theme}`,
  ]}
>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    <div class="grid gap-lg md:grid-cols-2 max-w-4xl mx-auto items-start">
      {/* Us card — highlighted */}
      <div class="compare-card compare-card-us surface-base">
        <div class="card-head">
          <span class="theme-accent text-xs font-bold uppercase tracking-widest"
            >Recommended</span
          >
          <h3 class="theme-heading text-xl font-bold m-0 mt-1">{usLabel}</h3>
          {
            data?.usTagline && (
              <p class="theme-text-muted text-sm m-0 mt-1">{data.usTagline}</p>
            )
          }
        </div>
        <ul class="card-list">
          {
            rows.map((row) => (
              <li class="card-list-item">
                <svg
                  class="check-icon"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="var(--theme-accent, var(--color-primary))"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  role="img"
                  aria-label="Yes"
                >
                  <path d="M4 10.5l4 4 8-9" />
                </svg>
                <div>
                  <span class="theme-text text-sm font-medium">
                    {row.feature}
                  </span>
                  {typeof row.us === "string" && (
                    <span class="theme-text-muted text-sm block">{row.us}</span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        {
          ctas.length > 0 && (
            <div class="card-foot">
              <Button
                href={ctas[0].href}
                variant={ctas[0].variant ?? "primary"}
                class="w-full"
              >
                {ctas[0].label}
              </Button>
            </div>
          )
        }
      </div>

      {/* Them card — muted */}
      <div class="compare-card compare-card-them">
        <div class="card-head">
          <span
            class="theme-text-subtle text-xs font-bold uppercase tracking-widest"
            >Compare</span
          >
          <h3 class="theme-text text-xl font-bold m-0 mt-1">{themLabel}</h3>
          {
            data?.themTagline && (
              <p class="theme-text-subtle text-sm m-0 mt-1">
                {data.themTagline}
              </p>
            )
          }
        </div>
        <ul class="card-list">
          {
            rows.map((row) => (
              <li class="card-list-item">
                {typeof row.them === "boolean" && row.them === false ? (
                  <svg
                    class="cross-icon theme-text-subtle"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    role="img"
                    aria-label="No"
                  >
                    <path d="M5 5l10 10M15 5L5 15" />
                  </svg>
                ) : (
                  <svg
                    class="dot-icon theme-text-subtle"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    role="img"
                    aria-label="Varies"
                  >
                    <circle cx="10" cy="10" r="3" />
                  </svg>
                )}
                <div>
                  <span class="theme-text-muted text-sm">{row.feature}</span>
                  {typeof row.them === "string" && (
                    <span class="theme-text-subtle text-sm block">
                      {row.them}
                    </span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      ctas.length > 1 && (
        <div class="flex justify-center mt-10">
          <Button
            href={ctas[1].href}
            variant={ctas[1].variant ?? "outline"}
          >
            {ctas[1].label}
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .compare-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .compare-card-us {
    box-shadow: var(--t-shadow-lg);
    border-color: color-mix(
      in srgb,
      var(--theme-accent, var(--color-primary)) 45%,
      var(--theme-border)
    );
    /* This card is always the solid light surface, so pin on-light text tokens
       here — otherwise a dark section renders its text light-on-white. */
    --theme-fg: var(--t-fg-on-light);
    --theme-heading: var(--t-fg-on-light);
    --theme-fg-muted: rgba(14, 42, 63, 0.65);
    --theme-fg-subtle: rgba(14, 42, 63, 0.45);
    --theme-border: rgba(14, 42, 63, 0.12);
    color: var(--t-fg-on-light);
  }
  /* The var-based theme tokens don't reliably flip on this white card, so pin
     the text colors directly. Keeps the teal accent + checks untouched. */
  .compare-card-us :is(.theme-heading, h3) { color: var(--t-fg-on-light) !important; }
  .compare-card-us .theme-text { color: var(--t-fg-on-light) !important; }
  .compare-card-us .theme-text-muted { color: rgba(14, 42, 63, 0.7) !important; }
  .compare-card-us .theme-text-subtle { color: rgba(14, 42, 63, 0.5) !important; }
  .card-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--theme-border);
  }
  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }
  .card-list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .check-icon,
  .cross-icon,
  .dot-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
  }
</style>
