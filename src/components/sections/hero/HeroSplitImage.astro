---
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage } from "@/lib/images";
import type { Eyebrow, SectionCTA, ImageRef } from "@/types/sections";
import { highlight } from "@/lib/highlight";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * hero:split-image — two-column hero with content on one side and a large
 * image on the other. Stacks on mobile (content first). Set `imagePosition`
 * to place the image on the "left" or "right" (default "right").
 */
interface Props {
  theme?: string;
  data?: {
    backgroundImage?: { src: string; overlayOpacity?: number };
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    body?: string;
    ctas?: SectionCTA[];
    showPhone?: boolean;
    image?: ImageRef;
    imagePosition?: "left" | "right";
  };
}

const { theme = "default", data } = Astro.props;
const heroBg = await getBackgroundImage(data?.backgroundImage?.src, { width: 2200 });
const heroOverlay = (data?.backgroundImage?.overlayOpacity ?? 60) / 100;
const business = await getBusinessData();

const imageLeft = data?.imagePosition === "left";
const hasContent = !!(data?.eyebrow || data?.heading || data?.subheading || data?.body || data?.ctas?.length);
const hasImage = !!data?.image?.src;
---

{
  (hasContent || hasImage) && (
    <section class:list={["hero-split-image section-wrapper section-py", `theme-${theme}`, "hero-bg", heroBg ? "has-bg" : ""]} style={heroBg ? `--hero-image: url('${heroBg}'); --hero-overlay: ${heroOverlay}` : undefined}>
      <div class="section-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          {/* Content */}
          <div class:list={["flex flex-col gap-5", imageLeft ? "lg:order-2" : "lg:order-1"]}>
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              ))}

            {data?.heading && (
              <h1 class="hero-heading theme-heading font-extrabold m-0" set:html={highlight(data?.heading)}></h1>
            )}

            {data?.subheading && (
              <p class="hero-subheading theme-text-muted leading-relaxed m-0">{data.subheading}</p>
            )}

            {data?.body && (
              <p class="text-base leading-relaxed theme-text m-0">{data.body}</p>
            )}

            {(data?.ctas?.length || data?.showPhone) && (
              <div class="flex flex-wrap items-center gap-md mt-2">
                {data?.ctas?.map((cta) => (
                  <Button variant={cta.variant ?? "primary"} href={cta.href}>
                    {cta.label}
                  </Button>
                ))}
                {data?.showPhone && business.phone && (
                  <a
                    href={`tel:${business.phone}`}
                    class="inline-flex items-center gap-xs font-semibold text-base theme-text no-underline hover:opacity-80 transition-opacity"
                  >
                    <svg
                      class="w-4 h-4 shrink-0"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    {business.phone}
                  </a>
                )}
              </div>
            )}
          </div>

          {/* Image */}
          {hasImage && (
            <div class:list={[imageLeft ? "lg:order-1" : "lg:order-2"]}>
              <SmartImage
                src={data!.image!.src}
                alt={data!.image!.alt ?? ""}
                width={1200}
                loading="eager"
                fetchpriority="high"
                class="hero-image w-full h-full object-cover rounded-2xl"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .hero-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  .hero-subheading {
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-image {
    box-shadow: var(--t-shadow-lg);
    aspect-ratio: 4 / 3;
  }
</style>
