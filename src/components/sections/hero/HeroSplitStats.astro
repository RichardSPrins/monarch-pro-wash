---
import { getBusinessData } from "@/lib/utils";
import { getHeroBg } from "@/lib/images";
import type { Eyebrow, SectionCTA, StatItem } from "@/types/sections";
import { highlight } from "@/lib/highlight";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * hero:split-stats — two-column hero with content on the left and a panel of
 * proof stats on the right (instead of an image). Great social proof above the
 * fold without the weight of a photo. Stacks on mobile (content first).
 */
interface Props {
  theme?: string;
  data?: {
    backgroundImage?: { src: string; overlayOpacity?: number };
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
    showPhone?: boolean;
    stats?: StatItem[];
  };
}

const { theme = "default", data } = Astro.props;
const heroBg = await getHeroBg(data?.backgroundImage);
const business = await getBusinessData();

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
const stats = data?.stats ?? [];
---

<section class:list={["hero-split-stats section-wrapper section-py-lg", `theme-${theme}`, "hero-bg", heroBg ? "has-bg" : ""]} style={heroBg?.style}>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="flex flex-col gap-5">
        {data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))}

        {data?.heading && (
          <h1 class="hero-heading theme-heading font-extrabold m-0" set:html={highlight(data?.heading)}></h1>
        )}

        {data?.subheading && (
          <p class="hero-subheading theme-text-muted leading-relaxed m-0">{data.subheading}</p>
        )}

        {(ctas.length > 0 || data?.showPhone) && (
          <div class="flex flex-wrap items-center gap-md mt-2">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
            {data?.showPhone && business.phone && (
              <a href={`tel:${business.phone}`} class="inline-flex items-center gap-xs font-semibold text-base theme-text no-underline hover:opacity-80 transition-opacity">
                <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>
        )}
      </div>

      {stats.length > 0 && (
        <div class="grid grid-cols-2 gap-md">
          {stats.slice(0, 4).map((stat) => (
            <div class="stat-card rounded-2xl p-6 flex flex-col gap-1">
              <span class="text-4xl font-extrabold theme-accent leading-none">{stat.value}</span>
              <span class="text-sm font-semibold theme-text">{stat.label}</span>
              {stat.description && (
                <span class="text-xs theme-text-muted mt-1">{stat.description}</span>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .hero-subheading {
    font-size: clamp(1rem, 2vw, 1.25rem);
  }
  .stat-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    box-shadow: var(--t-shadow-md);
  }
</style>
