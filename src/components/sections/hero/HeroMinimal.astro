---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import { getBackgroundImage } from "@/lib/images";
import Badge from "@/components/elements/badge/Badge.astro";
import { highlight } from "@/lib/highlight";
import { Button } from "@/components/elements/button";

/**
 * hero:minimal — a compact, centered page header for interior pages
 * (about, legal, service detail). No background image; theme-driven.
 */
interface Props {
  theme?: string;
  data?: {
    backgroundImage?: { src: string; overlayOpacity?: number };
    eyebrow?: Eyebrow;
    headline?: string;
    heading?: string;
    subheadline?: string;
    subheading?: string;
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;
const heroBg = await getBackgroundImage(data?.backgroundImage?.src, { width: 2200 });
const heroOverlay = (data?.backgroundImage?.overlayOpacity ?? 60) / 100;
const headline = data?.headline ?? data?.heading;
const subheadline = data?.subheadline ?? data?.subheading;
const ctas = [data?.cta, data?.secondaryCta].filter(Boolean) as SectionCTA[];
---

<section class={`section-wrapper section-py-lg theme-${theme} hero-bg ${heroBg ? "has-bg" : ""}`} style={heroBg ? `--hero-image: url('${heroBg}'); --hero-overlay: ${heroOverlay}` : undefined}>
  <div class="section-container">
    <div class="flex flex-col items-center text-center gap-md max-w-2xl mx-auto">
      {
        data?.eyebrow && (
          data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
              {data.eyebrow.text}
            </span>
          )
        )
      }
      {headline && <h1 class="theme-heading text-4xl lg:text-5xl font-bold m-0" set:html={highlight(headline)}></h1>}
      {subheadline && <p class="theme-text-muted text-lg m-0">{subheadline}</p>}
      {
        ctas.length > 0 && (
          <div class="flex flex-wrap items-center justify-center gap-sm mt-2">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
