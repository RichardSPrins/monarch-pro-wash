---
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage } from "@/lib/images";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import { highlight } from "@/lib/highlight";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * hero:gradient — no image. A bold brand gradient background with a centered
 * heading/subheading/CTAs in light text. Punchy landing hero.
 */
interface Props {
  theme?: string;
  data?: {
    backgroundImage?: { src: string; overlayOpacity?: number };
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    ctas?: SectionCTA[];
    showPhone?: boolean;
  };
}

const { theme = "default", data } = Astro.props;
const heroBg = await getBackgroundImage(data?.backgroundImage?.src, { width: 2200 });
const heroOverlay = (data?.backgroundImage?.overlayOpacity ?? 60) / 100;
const business = await getBusinessData();

const heading = data?.heading;
const subheading = data?.subheading;
---

<section
  class:list={[
    "hero-gradient section-wrapper relative overflow-hidden flex items-center",
    `theme-${theme}`,
  , "hero-bg", heroBg ? "has-bg" : ""]} style={heroBg ? `--hero-image: url('${heroBg}'); --hero-overlay: ${heroOverlay}` : undefined}
>
  <div class="section-container relative z-10 py-24 lg:py-32">
    <div class="flex flex-col items-center text-center gap-5 max-w-3xl mx-auto">
      {
        data?.eyebrow && (
          data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
              {data.eyebrow.text}
            </span>
          )
        )
      }
      {heading && <h1 class="theme-heading text-4xl sm:text-5xl lg:text-6xl font-bold m-0 leading-tight" set:html={highlight(heading)}></h1>}
      {subheading && <p class="theme-text-muted text-lg lg:text-xl max-w-2xl m-0">{subheading}</p>}
      {
        (data?.ctas?.length || data?.showPhone) && (
          <div class="flex flex-wrap items-center justify-center gap-sm mt-2">
            {data?.ctas?.map((cta) => (
              <Button variant={cta.variant ?? "primary"} href={cta.href}>{cta.label}</Button>
            ))}
            {data?.showPhone && business.phone && (
              <a href={`tel:${business.phone}`} class="inline-flex items-center gap-xs font-bold text-lg theme-text hover:opacity-80 transition-opacity no-underline">
                <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-gradient {
    min-height: 520px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-bg-inverse));
    /* Light text on the dark gradient, token-driven regardless of theme prop. */
    --theme-heading: var(--color-fg-on-primary);
    --theme-fg: var(--color-fg-on-primary);
    --theme-fg-muted: var(--color-fg-on-primary);
  }
  .hero-gradient :global(.theme-text-muted) {
    opacity: 0.8;
  }
</style>
