---
import FormRenderer from "@/components/forms/FormRenderer.astro";
import type { HeroData } from "./types";
import { highlight } from "@/lib/highlight";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage, FOCAL_POSITION } from "@/lib/images";
import { getServices } from "@/lib/content";

interface Props {
  theme?: string;
  data?: HeroData;
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();
const services = await getServices();
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const bgUrl = await getBackgroundImage(data?.backgroundImage?.src, { width: 2000 });
const hasBackground = !!bgUrl;
const overlayOpacity = (data?.backgroundImage?.overlayOpacity ?? 60) / 100;
const fpos = (f?: string) => FOCAL_POSITION[(f ?? "center") as keyof typeof FOCAL_POSITION] ?? "center";
const heroPos = fpos(data?.backgroundImage?.focal);
const heroPosMobile = fpos(data?.backgroundImage?.focalMobile ?? data?.backgroundImage?.focal); // mobile falls back to desktop focal
---

<section
  class:list={[
    "hero-split section-wrapper section-py relative z-20 min-h-[600px]",
    `theme-${theme}`,
    hasBackground ? "has-bg" : "no-bg",
  ]}
  style={hasBackground
    ? `--hero-image: url('${bgUrl}'); --hero-overlay: ${overlayOpacity}; --hero-position: ${heroPos}; --hero-position-mobile: ${heroPosMobile}`
    : ""}
>
  <div class="section-container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left — content -->
      <div class="col-span-2 md:col-span-1 flex flex-col gap-5">
        {
          data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge
                  class="uppercase text-white bg-primary-accent tracking-widest text-xs text-wrap"
                  size="lg"
                >
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )
        }

        <h1
          class="hero-heading theme-heading font-extrabold m-0"
          set:html={highlight(data?.useBusinessName ? business.businessName : data?.heading)}
        ></h1>

        {
          data?.subheading && (
            <p class="hero-subheading theme-text-muted leading-relaxed m-0">
              {data.subheading}
            </p>
          )
        }

        {
          data?.body && (
            <div class="flex flex-col gap-sm text-base leading-relaxed theme-text">
              {Array.isArray(data.body) ? (
                data.body.map((p) => <p class="m-0">{p}</p>)
              ) : (
                <p class="m-0">{data.body}</p>
              )}
            </div>
          )
        }

        {
          data?.trustBadges && data.trustBadges.length > 0 && (
            <div class="flex flex-wrap gap-x-lg gap-y-xs">
              {data.trustBadges.map((badge) => (
                <span class="flex items-center gap-1.5 text-sm font-medium theme-text-muted">
                  <svg
                    class="w-4 h-4 shrink-0 text-color-brand-secondary"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {badge.text}
                </span>
              ))}
            </div>
          )
        }

        {
          data?.offer && (
            <div
              class="inline-flex items-center gap-xs px-4 py-2.5 rounded-lg border text-sm"
              style="background: color-mix(in srgb, var(--color-brand-secondary) 12%, transparent); border-color: color-mix(in srgb, var(--color-brand-secondary) 30%, transparent)"
            >
              {data.offer.label && (
                <span class="font-bold text-xs uppercase tracking-wide text-color-brand-secondary">
                  {data.offer.label}
                </span>
              )}
              <span class="theme-text">{data.offer.text}</span>
            </div>
          )
        }

        {
          data?.ctas && data.ctas.length > 0 && (
            <div class="flex flex-wrap items-center gap-md mt-2">
              {data.ctas.map((cta) => (
                <Button variant={cta.variant ?? "primary"} href={cta.href}>
                  {cta.label}
                </Button>
              ))}
              {data?.showPhone && business.phone && (
                <a
                  href={`tel:${business.phone}`}
                  class="flex items-center gap-xs font-semibold text-base theme-text no-underline hover:opacity-80 transition-opacity"
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  {business.phone}
                </a>
              )}
            </div>
          )
        }
      </div>

      <!-- Right — form -->
      <div class="w-full col-span-2 md:col-span-1">
        <FormRenderer form={data?.form} services={sortedServices} />
      </div>
    </div>
  </div>
</section>

<style>
  /* Pseudo elements only — everything else is Tailwind */

  .hero-split.has-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--hero-image);
    background-size: cover;
    background-position: var(--hero-position, center);
    background-repeat: no-repeat;
  }
  /* Mobile stacks/crops tighter, so honor a mobile focal (falls back to desktop). */
  @media (max-width: 767px) {
    .hero-split.has-bg::before {
      background-position: var(--hero-position-mobile, var(--hero-position, center));
    }
  }

  .hero-split.has-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--hero-overlay, 0.6));
  }

  .hero-split.no-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      135deg,
      var(--color-bg-primary) 0%,
      var(--color-bg-inverse) 100%
    );
  }

  .hero-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  .hero-subheading {
    font-size: clamp(1rem, 2vw, 1.25rem);
  }
</style>
