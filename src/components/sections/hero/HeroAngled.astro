---
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage, FOCAL_POSITION } from "@/lib/images";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import { highlight } from "@/lib/highlight";
import { Button } from "@/components/elements/button";
import HeroQuoteForm from "@/components/elements/HeroQuoteForm.astro";

/**
 * hero:angled — REBUILT. A photo-forward hero (no flat-color slab, no hard
 * diagonal slice). Content sits over a darkened full-bleed photo with a
 * directional gradient; the only nod to "angled" is a small skewed accent bar
 * under the eyebrow. Optional rating trio + trust chips for proof.
 */
interface Rating { platform?: string; score?: number | string }
interface Props {
  theme?: string;
  data?: {
    backgroundImage?: { src: string; overlayOpacity?: number; focal?: string; focalMobile?: string };
    image?: { src?: string };
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    body?: string;
    ctas?: SectionCTA[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    showPhone?: boolean;
    quoteForm?: boolean;
    ratings?: Rating[];
    combinedReviews?: string;
    trustBadges?: Array<{ text: string }>;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const ctas = (data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)) as SectionCTA[];
const ratings = data?.ratings ?? [];
const badges = data?.trustBadges ?? [];
const quoteForm = data?.quoteForm ?? false;

const bgSrc = data?.backgroundImage?.src ?? data?.image?.src;
const bgUrl = await getBackgroundImage(bgSrc, { width: 2200 });
const hasBackground = !!bgUrl;
const overlayOpacity = (data?.backgroundImage?.overlayOpacity ?? 55) / 100;
// Focal lives on the background image (data.backgroundImage.focal / .focalMobile).
const fpos = (f?: string) => FOCAL_POSITION[(f ?? "center") as keyof typeof FOCAL_POSITION] ?? "center";
const heroPos = fpos(data?.backgroundImage?.focal);
const heroPosMobile = fpos(data?.backgroundImage?.focalMobile ?? data?.backgroundImage?.focal);
---

<section
  class:list={["hero-angled section-wrapper relative overflow-hidden flex items-center", `theme-${theme}`, hasBackground ? "has-bg" : "no-bg"]}
  style={hasBackground ? `--hero-image: url('${bgUrl}'); --hero-overlay: ${overlayOpacity}; --hero-position: ${heroPos}; --hero-position-mobile: ${heroPosMobile}` : ""}
>
  <div class="section-container relative z-10 py-20 lg:py-28">
    <div class:list={[quoteForm && "hero-form-grid"]}>
    <div class:list={["flex flex-col gap-5", quoteForm ? "max-w-xl" : "max-w-2xl"]}>
      {
        data?.eyebrow && (
          <span class="hero-eyebrow">
            <span class="hero-accent" aria-hidden="true"></span>
            <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">{data.eyebrow.text}</span>
          </span>
        )
      }
      {
        ratings.length > 0 && (
          <div class="hero-ratings">
            {ratings.map((r) => (
              <span class="rating-lockup">
                {r.platform && <span class="rating-platform">{r.platform}</span>}
                <span class="rating-stars" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map(() => (<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 7.1-1.01L12 2z" /></svg>))}
                </span>
                <span class="rating-score">{r.score}</span>
              </span>
            ))}
            {data?.combinedReviews && <span class="rating-combined">{data.combinedReviews}</span>}
          </div>
        )
      }
      {data?.heading && <h1 class="hero-h font-extrabold m-0 leading-[1.05] text-white" set:html={highlight(data.heading)}></h1>}
      {data?.subheading && <p class="text-lg lg:text-xl m-0 text-white/85 max-w-xl">{data.subheading}</p>}
      {data?.body && <p class="text-base leading-relaxed m-0 text-white/80 max-w-xl">{data.body}</p>}

      {
        (ctas.length > 0 || data?.showPhone) && (
          <div class="flex flex-wrap items-center gap-sm mt-2">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>{cta.label}</Button>
            ))}
            {data?.showPhone && business.phone && (
              <a href={`tel:${business.phone}`} class="inline-flex items-center gap-xs font-bold text-lg text-white hover:opacity-80 transition-opacity no-underline">
                <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                {business.phone}
              </a>
            )}
          </div>
        )
      }
      {
        badges.length > 0 && (
          <ul class="hero-chips">
            {badges.map((b) => (
              <li class="hero-chip">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                {b.text}
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {quoteForm && <HeroQuoteForm />}
    </div>
  </div>
</section>

<style>
  .hero-angled { min-height: 620px; }
  /* Form on → 2-column split (content + quote card); off → natural narrow content. */
  .hero-form-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  @media (min-width: 1024px) { .hero-form-grid { grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; } }
  .hero-angled.has-bg::before {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background-image: var(--hero-image); background-size: cover; background-position: var(--hero-position, center);
  }
  @media (max-width: 767px) {
    .hero-angled.has-bg::before { background-position: var(--hero-position-mobile, var(--hero-position, center)); }
  }
  .hero-angled.has-bg::after {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(100deg, rgba(0,0,0,calc(var(--hero-overlay,0.55) + 0.2)) 0%, rgba(0,0,0,var(--hero-overlay,0.55)) 48%, rgba(0,0,0,calc(var(--hero-overlay,0.55) - 0.2)) 100%);
  }
  .hero-angled.no-bg::before {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(155deg, var(--t-bg) 0%, var(--t-bg-inverse) 100%);
  }

  .hero-h { font-size: clamp(2.3rem, 5vw, 3.85rem); text-wrap: balance; }

  /* The only "angle" — a small skewed accent bar, not a slab. */
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.6rem; }
  .hero-accent { width: 2.25rem; height: 0.3rem; border-radius: 2px; background: var(--t-primary); transform: skewX(-24deg); }

  .hero-ratings { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; }
  .rating-lockup { display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.16); backdrop-filter: blur(4px); border-radius: 999px; padding: 0.28rem 0.65rem; }
  .rating-platform { font-size: 0.72rem; font-weight: 700; color: #fff; }
  .rating-stars { display: inline-flex; gap: 0.05rem; color: var(--color-rating); }
  .rating-stars svg { width: 0.82rem; height: 0.82rem; }
  .rating-score { font-size: 0.76rem; font-weight: 800; color: #fff; }
  .rating-combined { font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,0.85); }

  .hero-chips { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .hero-chip { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; color: #fff; }
  .hero-chip svg { width: 1rem; height: 1rem; color: var(--t-secondary-light); }
</style>
