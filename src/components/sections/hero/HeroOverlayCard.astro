---
import { getBusinessData } from "@/lib/utils";
import { getHeroBg } from "@/lib/images";
import type { Eyebrow, SectionCTA, ImageRef } from "@/types/sections";
import { highlight } from "@/lib/highlight";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * hero:overlay-card — a full-bleed background image with a solid content card
 * floating over it (offset to one side). Unlike hero:image-overlay (text sits
 * directly on the image), the card guarantees legibility over any photo because
 * it establishes its own light surface via `.surface-base`.
 */
interface Props {
  theme?: string;
  data?: {
    backgroundImage?: { src: string; overlayOpacity?: number };
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    body?: string;
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
    showPhone?: boolean;
    image?: ImageRef;
    cardPosition?: "left" | "right";
  };
}

const { theme = "default", data } = Astro.props;
const heroBg = await getHeroBg(data?.backgroundImage);
const business = await getBusinessData();

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
const cardRight = data?.cardPosition === "right";
const hasImage = !!data?.image?.src;
---

<section class:list={["hero-overlay-card section-wrapper section-py-lg relative overflow-hidden", `theme-${theme}`, "hero-bg", heroBg ? "has-bg" : ""]} style={heroBg?.style}>
  {hasImage && (
    <div class="absolute inset-0 z-0">
      <SmartImage
        src={data!.image!.src}
        alt={data!.image!.alt ?? ""}
        width={1920}
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 hero-scrim" aria-hidden="true"></div>
    </div>
  )}

  <div class="section-container relative z-10">
    <div class:list={["grid grid-cols-1 lg:grid-cols-12", cardRight ? "justify-items-end" : ""]}>
      <div class:list={["surface-base rounded-3xl p-8 lg:p-10 flex flex-col gap-5 max-w-xl w-full lg:col-span-6", cardRight ? "lg:col-start-7" : ""]}>
        {data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs self-start">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))}

        {data?.heading && (
          <h1 class="hero-heading theme-heading font-extrabold m-0" set:html={highlight(data?.heading)}></h1>
        )}

        {data?.subheading && (
          <p class="hero-subheading theme-text-muted leading-relaxed m-0">{data.subheading}</p>
        )}

        {data?.body && <p class="text-base leading-relaxed theme-text m-0">{data.body}</p>}

        {(ctas.length > 0 || data?.showPhone) && (
          <div class="flex flex-wrap items-center gap-md mt-1">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
            {data?.showPhone && business.phone && (
              <a href={`tel:${business.phone}`} class="inline-flex items-center gap-xs font-semibold text-base theme-text no-underline hover:opacity-80 transition-opacity">
                <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-overlay-card {
    min-height: 32rem;
    display: flex;
    align-items: center;
  }
  .hero-scrim {
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.35),
      rgba(0, 0, 0, 0.15)
    );
  }
  .hero-heading {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
  }
  .hero-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
</style>
