---
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage } from "@/lib/images";
import { highlight } from "@/lib/highlight";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * cta:banner — a full-width color band with the message on one side and the
 * action(s) on the other (stacks on mobile). Optional background image/overlay
 * and phone. The standard section-break conversion prompt.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    ctas?: SectionCTA[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    showPhone?: boolean;
    backgroundImage?: { src: string; overlayOpacity?: number };
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const ctas = [...(data?.ctas ?? []), data?.cta, data?.secondaryCta].filter(Boolean) as SectionCTA[];

const bgUrl = await getBackgroundImage(data?.backgroundImage?.src, { width: 2000 });
const hasBackground = !!bgUrl;
const overlayOpacity = (data?.backgroundImage?.overlayOpacity ?? 65) / 100;
---

<section
  class:list={["cta-banner section-wrapper section-py-lg relative overflow-hidden", `theme-${theme}`, hasBackground ? "has-bg" : "no-bg"]}
  style={hasBackground ? `--cta-image: url('${bgUrl}'); --cta-overlay: ${overlayOpacity}` : ""}
>
  <div class="section-container relative z-10">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-lg">
      <div class="flex flex-col gap-sm max-w-2xl">
        {
          data?.eyebrow && (
            data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )
          )
        }
        {data?.heading && <h2 class="theme-heading text-2xl lg:text-4xl font-bold m-0 leading-tight" set:html={highlight(data?.heading)}></h2>}
        {data?.subheading && <p class="theme-text-muted text-lg m-0">{data.subheading}</p>}
      </div>

      {
        (ctas.length > 0 || data?.showPhone) && (
          <div class="flex flex-wrap items-center gap-md shrink-0">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant || (i === 0 ? "primary" : "outline")} href={cta.href}>{cta.label}</Button>
            ))}
            {data?.showPhone && business.phone && (
              <a href={`tel:${business.phone}`} class="inline-flex items-center gap-xs font-bold text-lg theme-text hover:opacity-80 transition-opacity no-underline">
                <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-banner.has-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--cta-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .cta-banner.has-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--cta-overlay, 0.65));
  }
</style>
