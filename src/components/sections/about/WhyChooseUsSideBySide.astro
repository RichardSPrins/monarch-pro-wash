---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";
import SmartImage from "@/components/media/SmartImage.astro";

interface StatCard {
  value: string;
  label: string;
  description?: string;
}

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    body?: string;
    stats?: StatCard[];
    /**
     * Optional. The template has always guarded on this, but the type demanded
     * it — which silently failed the section in prod for any page without
     * photography. Without an image the section renders as a single column.
     */
    image?: { src: string; alt?: string };
    overlayText?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

// No image (or an image-only overlay badge) means no second column to fill.
const hasMedia = Boolean(data?.image || data?.overlayText);
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    <div
      class:list={[
        "grid grid-cols-1 gap-12 lg:gap-16 items-center",
        hasMedia && "lg:grid-cols-2",
      ]}
    >
      {/* Content — left */}
      <div class="flex flex-col gap-lg">
        {
          data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )
        }

        {
          data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )
        }

        {
          data?.body && (
            <p class="theme-text-muted text-lg leading-relaxed m-0">
              {data.body}
            </p>
          )
        }

        {/* Stat cards */}
        {
          data?.stats && data.stats.length > 0 && (
            <div
              class={`grid gap-md mt-2 ${data.stats.length === 2 ? "grid-cols-2" : data.stats.length === 3 ? "grid-cols-3" : "grid-cols-2"}`}
            >
              {data.stats.map((stat) => (
                <div class="flex flex-col gap-1 p-4 rounded-xl border theme-border">
                  <span class="stat-value text-3xl font-black text-primary leading-none">
                    {stat.value}
                  </span>
                  <span class="theme-heading font-semibold text-sm">
                    {stat.label}
                  </span>
                  {stat.description && (
                    <span class="theme-text-subtle text-xs leading-relaxed">
                      {stat.description}
                    </span>
                  )}
                </div>
              ))}
            </div>
          )
        }

        {
          data?.cta && (
            <div class="mt-2">
              <Button
                variant={data.cta.variant ?? "primary"}
                href={data.cta.href}
              >
                {data.cta.label}
              </Button>
            </div>
          )
        }
      </div>

      {/* Image — right with overlay. Skipped entirely when there's no media. */}
      <div class="image-wrapper" hidden={!hasMedia}>
        {
          data?.image && (
            <SmartImage
              src={data.image.src}
              alt={data.image.alt ?? ""}
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full h-full object-cover"
            />
          )
        }

        {/* Decorative overlay badge */}
        {
          data?.overlayText && (
            <div class="overlay-badge">
              <svg
                class="overlay-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              <span>{data.overlayText}</span>
            </div>
          )
        }

        {/* Decorative corner accent */}
        <div class="corner-accent" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .image-wrapper {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .image-wrapper img {
    border-radius: 1.5rem;
  }

  /* Dark gradient overlay on image */
  .image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--theme-accent) 35%, transparent) 0%,
      transparent 60%
    );
    border-radius: 1.5rem;
    pointer-events: none;
  }

  /* Floating badge overlay */
  .overlay-badge {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--theme-accent);
    box-shadow: var(--t-shadow-md);
  }

  .overlay-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-brand-secondary);
    fill: var(--color-brand-secondary);
    flex-shrink: 0;
  }

  /* Decorative corner block */
  .corner-accent {
    position: absolute;
    top: -1rem;
    right: -1rem;
    width: 5rem;
    height: 5rem;
    border-radius: 0.75rem;
    background: var(--color-brand-secondary);
    opacity: 0.15;
    z-index: -1;
    transform: rotate(12deg);
  }
</style>
