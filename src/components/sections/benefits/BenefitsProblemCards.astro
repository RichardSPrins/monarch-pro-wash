---
import type { Eyebrow } from "@/types/sections";

/**
 * benefits:problem-cards — a grid of problem-agitation cards (icon · problem ·
 * why it matters). Names the pain before you pitch the fix (Sudsy "Is your trash
 * can making your home disgusting?"). Theme-aware.
 */
interface Problem { icon?: string; title?: string; body?: string }
interface Props {
  theme?: string;
  data?: { eyebrow?: Eyebrow; heading?: string; subheading?: string; problems?: Problem[] };
}

const { theme = "default", data } = Astro.props;
const problems = data?.problems ?? [];

const ICON: Record<string, string> = {
  alert: '<path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>',
  droplet: '<path d="M12 2.5S5 9 5 14a7 7 0 0 0 14 0c0-5-7-11.5-7-11.5z"/>',
  bug: '<path d="M8 2l1.5 1.5M16 2l-1.5 1.5"/><path d="M9 7h6a4 4 0 0 1 4 4v3a7 7 0 0 1-14 0v-3a4 4 0 0 1 4-4z"/><path d="M2 12h3M19 12h3M4 6l2 2M20 6l-2 2M4 18l2-2M20 18l-2-2"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  dollar: '<path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  crack: '<path d="M9 2l3 7-4 2 5 11-2-9 4-2-6-9z"/>',
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
};
---

{
  problems.length > 0 && (
    <section class:list={["section-wrapper section-py", `theme-${theme}`]}>
      <div class="section-container">
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow && <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">{data.eyebrow.text}</span>}
            {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
            {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
          </div>
        )}
        <div class="bpc">
          {problems.map((p) => (
            <article class="bpc-card">
              <span class="bpc-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[p.icon ?? "alert"] ?? ICON.alert} />
              </span>
              {p.title && <h3 class="bpc-title theme-heading">{p.title}</h3>}
              {p.body && <p class="bpc-body theme-text-muted">{p.body}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .bpc { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .bpc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .bpc { grid-template-columns: repeat(4, 1fr); } }

  .bpc-card {
    display: flex; flex-direction: column; gap: 0.7rem; padding: 1.5rem 1.4rem; border-radius: 1rem;
    border: 1px solid var(--color-border); background: var(--card);
    box-shadow: 0 10px 26px -20px rgba(0, 0, 0, 0.4);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .bpc-card:hover { transform: translateY(-3px); box-shadow: 0 20px 44px -22px rgba(0, 0, 0, 0.5); }
  .bpc-icon {
    width: 3rem; height: 3rem; border-radius: 0.85rem; display: grid; place-items: center; flex-shrink: 0;
    color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }
  .bpc-icon svg { width: 1.5rem; height: 1.5rem; }
  .bpc-title { margin: 0; font-size: 1.05rem; font-weight: 700; line-height: 1.25; }
  .bpc-body { margin: 0; font-size: 0.88rem; line-height: 1.55; }
</style>
