---
import { getFaqs } from "@/lib/content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    service?: string;
    limit?: number;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const allFaqs = await getFaqs();

const faqs = allFaqs
  .filter((f) => data?.service ? f.data.service === data.service : !f.data.service)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? allFaqs.length);
---

<section class:list={["faqs-contact-split section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16">
      {/* Sticky intro + CTA */}
      <div class="lg:col-span-2">
        <div class="lg:sticky lg:top-24 flex flex-col gap-md">
          {data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
          )}
          <div class="mt-2">
            <Button variant={data?.cta?.variant ?? "primary"} href={data?.cta?.href ?? "/contact"}>
              {data?.cta?.label ?? "Contact us"}
            </Button>
          </div>
        </div>
      </div>

      {/* FAQ list */}
      <div class="lg:col-span-3">
        {
          faqs.length > 0 ? (
            <div class="flex flex-col">
              {faqs.map((faq) => (
                <div class="py-6 first:pt-0 last:pb-0 faq-row">
                  <h3 class="theme-heading font-semibold text-lg m-0">
                    {faq.data.question}
                  </h3>
                  <p class="theme-text-muted leading-relaxed mt-2 mb-0">
                    {faq.data.answer}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <p class="theme-text-muted">No FAQs found.</p>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-row + .faq-row {
    border-top: 1px solid var(--theme-border);
  }
</style>
