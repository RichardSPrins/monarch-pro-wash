---
import { getFaqs } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    service?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const allFaqs = await getFaqs();

const faqs = allFaqs
  .filter((f) => data?.service ? f.data.service === data.service : !f.data.service)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? allFaqs.length);

const [featured, ...rest] = faqs;
---

<section class:list={["faqs-feature section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col gap-sm mb-12 max-w-2xl">
          {data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
          )}
        </div>
      )
    }

    {
      faqs.length > 0 ? (
        <div class="flex flex-col gap-xl">
          {featured && (
            <div
              class="surface-base p-8 lg:p-10"
              style="border-radius: var(--t-radius); box-shadow: var(--t-shadow-md);"
            >
              <h3 class="theme-heading font-bold text-2xl lg:text-3xl m-0">
                {featured.data.question}
              </h3>
              <p class="theme-text-muted text-lg leading-relaxed mt-4 mb-0 max-w-3xl">
                {featured.data.answer}
              </p>
            </div>
          )}

          {rest.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-xl">
              {rest.map((faq) => (
                <div>
                  <h3 class="theme-heading font-semibold text-lg m-0">
                    {faq.data.question}
                  </h3>
                  <p class="theme-text-muted leading-relaxed mt-2 mb-0">
                    {faq.data.answer}
                  </p>
                </div>
              ))}
            </div>
          )}
        </div>
      ) : (
        <p class="theme-text-muted">No FAQs found.</p>
      )
    }
  </div>
</section>
