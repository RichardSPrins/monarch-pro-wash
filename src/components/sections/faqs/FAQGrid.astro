---
import { getFaqs } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    service?: string;
  };
}

const { theme = "default", data } = Astro.props;

const allFaqs = await getFaqs();

const faqs = allFaqs
  .filter((f) => data?.service ? f.data.service === data.service : !f.data.service)
  .sort((a, b) => a.data.order - b.data.order);
---

{
  faqs.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Q&A grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
          {faqs.map((faq) => (
            <div class="rounded-xl border theme-border bg-background p-6">
              <h3 class="theme-heading font-semibold text-lg m-0">
                {faq.data.question}
              </h3>
              <p class="theme-text-muted leading-relaxed mt-2 mb-0">
                {faq.data.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
