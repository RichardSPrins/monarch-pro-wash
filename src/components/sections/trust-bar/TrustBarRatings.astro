---
import type { Eyebrow, RatingSource } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    sources?: RatingSource[];
  };
}

const { theme = "default", data } = Astro.props;

const sources = data?.sources ?? [];

/** Third-party brand colors — the allowed hardcode exception. */
const brandColors: Record<string, string> = {
  Google: "#4285F4",
  Facebook: "#1877F2",
  Yelp: "#D32323",
};
---

{
  sources.length > 0 && (
    <section class={`section-wrapper section-py-sm theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-8">
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
          </div>
        )}

        {/* Ratings row */}
        <ul class="flex flex-wrap items-center justify-center gap-y-lg gap-x-xl md:gap-x-12 list-none m-0 p-0">
          {sources.map((source) => {
            const filled = Math.round(source.rating);
            const empty = Math.max(0, 5 - filled);
            const brandColor = brandColors[source.name];

            const item = (
              <div class="flex items-center gap-sm">
                <span class="flex items-center gap-1.5">
                  {source.name?.toLowerCase() === "google" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                  )}
                  {source.name?.toLowerCase() === "facebook" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.44 18.63.07 12 .07S0 5.44 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z" fill="#1877F2"/></svg>
                  )}
                  <span class:list={["text-sm font-bold leading-none", !brandColor && "theme-text"]} style={brandColor ? `color: ${brandColor}` : undefined}>{source.name}</span>
                </span>
                <span
                  class="flex items-center gap-0.5"
                  aria-label={`${source.rating} out of 5 stars`}
                >
                  {Array.from({ length: filled }).map(() => (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 20 20"
                      fill="var(--color-rating)"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                  {Array.from({ length: empty }).map(() => (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 20 20"
                      fill="var(--color-rating-empty)"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </span>
                <span class="text-sm font-bold theme-text leading-none">
                  {source.rating.toFixed(1)}
                </span>
                {source.count != null && (
                  <span class="text-sm theme-text-muted leading-none">
                    ({source.count.toLocaleString()} reviews)
                  </span>
                )}
              </div>
            );

            return (
              <li class="flex items-center">
                {source.url ? (
                  <a href={source.url} class="no-underline">
                    {item}
                  </a>
                ) : (
                  item
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
