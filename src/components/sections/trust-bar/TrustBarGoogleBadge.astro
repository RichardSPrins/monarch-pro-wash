---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow } from "@/types/sections";

/**
 * trust-bar:google-badge — the classic Google review widget lockup: big Google
 * logo, "Google Rating", score, gold stars, review count, and a link to read
 * them. One prominent, recognizable trust badge. Theme-aware card.
 */
interface Props {
  theme?: string;
  data?: { eyebrow?: Eyebrow; rating?: number; count?: number; reviewUrl?: string; label?: string };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();
const rating = data?.rating ?? 4.9;
const count = data?.count;
const url = data?.reviewUrl ?? business.gbpUrl;
const filled = Math.round(rating);
---

<section class:list={["section-wrapper section-py-sm", `theme-${theme}`]}>
  <div class="section-container flex justify-center">
    <div class="gb">
      <span class="gb-logo" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
      </span>
      <span class="gb-body">
        <span class="gb-label theme-text-muted">{data?.label ?? "Google Rating"}</span>
        <span class="gb-row">
          <strong class="gb-score theme-heading">{rating.toFixed(1)}</strong>
          <span class="gb-stars" aria-hidden="true">
            {Array.from({ length: 5 }, (_, i) => i < filled).map((f) => (
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" class={f ? "on" : "off"}><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </span>
        </span>
        {count != null && <span class="gb-count theme-text-subtle">Based on {count.toLocaleString()} reviews</span>}
      </span>
      {url && (
        <a class="gb-link" href={url} target="_blank" rel="noopener noreferrer">
          Read reviews
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .gb {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; justify-content: center;
    padding: 1rem 1.5rem; border-radius: 1rem; border: 1px solid var(--color-border); background: var(--card);
    box-shadow: 0 12px 30px -20px rgba(0, 0, 0, 0.45);
  }
  .gb-logo { display: inline-flex; flex-shrink: 0; }
  .gb-body { display: flex; flex-direction: column; gap: 0.1rem; }
  .gb-label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .gb-row { display: flex; align-items: center; gap: 0.55rem; }
  .gb-score { font-size: 1.6rem; font-weight: 800; line-height: 1; }
  .gb-stars { display: inline-flex; gap: 0.06rem; }
  .gb-stars .on { color: var(--color-rating); }
  .gb-stars .off { color: var(--color-rating-empty); }
  .gb-count { font-size: 0.75rem; }
  .gb-link { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 700; color: var(--color-primary); text-decoration: none; margin-left: 0.25rem; }
  .gb-link:hover { text-decoration: underline; }
</style>
