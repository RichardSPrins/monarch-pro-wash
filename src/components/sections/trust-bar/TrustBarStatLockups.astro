---
import type { Eyebrow } from "@/types/sections";

/**
 * trust-bar:stat-lockups — a row of compact stat pills (big value + small
 * label): 15+ Years · 500+ Jobs · 4.9★ · Same-Day. Denser and more "badge-like"
 * than trust-bar:stats. Theme-aware.
 */
interface Stat { value?: string; label?: string }
interface Props {
  theme?: string;
  data?: { eyebrow?: Eyebrow; heading?: string; stats?: Stat[] };
}

const { theme = "default", data } = Astro.props;
const stats = data?.stats ?? [];
---

<section class:list={["section-wrapper section-py-sm", `theme-${theme}`]}>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-8">
          {data?.eyebrow && <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">{data.eyebrow.text}</span>}
          {data?.heading && <h2 class="theme-heading text-2xl lg:text-3xl font-bold m-0">{data.heading}</h2>}
        </div>
      )
    }
    <div class="tsl">
      {stats.map((s) => (
        <div class="tsl-pill">
          <span class="tsl-value theme-heading">{s.value}</span>
          <span class="tsl-label theme-text-muted">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tsl { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; }
  .tsl-pill {
    display: flex; flex-direction: column; align-items: center; gap: 0.15rem; min-width: 8rem;
    padding: 0.9rem 1.4rem; border-radius: 1rem; border: 1px solid var(--color-border); background: var(--card);
    box-shadow: 0 10px 26px -20px rgba(0, 0, 0, 0.4);
  }
  .tsl-value { font-size: 1.65rem; font-weight: 800; line-height: 1; }
  .tsl-label { font-size: 0.78rem; font-weight: 600; text-align: center; }
</style>
