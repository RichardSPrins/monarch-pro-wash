---
import { getServices } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * services:showcase — larger service cards with the photo on top and the copy
 * below on the card surface (theme-aware), plus a "Learn more" arrow. Hover
 * lifts the card and gently zooms the photo. Fewer, bigger cards (Pool Envy).
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    columns?: 2 | 3;
    hrefBase?: string;
    ctaLabel?: string;
  };
}

const { theme = "default", data } = Astro.props;
const hrefBase = (data?.hrefBase ?? "/services").replace(/\/$/, "");
const cols = data?.columns ?? 3;

const services = (await getServices())
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? undefined);
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    <div class="flex flex-col items-center text-center gap-sm mb-12">
      {data?.eyebrow && <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">{data.eyebrow.text}</span>}
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class:list={["svc-sc", cols === 2 ? "cols-2" : "cols-3"]}>
      {
        services.map((s) => (
          <a href={`${hrefBase}/${s.data.slug}`} class="svc-sc-card group">
            <div class="svc-sc-media">
              {s.data.image ? (
                <SmartImage src={s.data.image} alt={s.data.title} width={820} class="svc-sc-img" loading="lazy" />
              ) : (
                <span class="svc-sc-fallback" aria-hidden="true" />
              )}
              {s.data.isEmergency && <span class="svc-sc-tag">Emergency</span>}
            </div>
            <div class="svc-sc-body">
              <h3 class="theme-heading svc-sc-title">{s.data.title}</h3>
              {s.data.description && <p class="theme-text-muted svc-sc-desc">{s.data.description}</p>}
              <span class="svc-sc-arrow">
                {data?.ctaLabel ?? "Learn more"}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc-sc { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .svc-sc.cols-2, .svc-sc.cols-3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .svc-sc.cols-3 { grid-template-columns: repeat(3, 1fr); } }

  .svc-sc-card {
    display: flex; flex-direction: column; border-radius: 1rem; overflow: hidden;
    border: 1px solid var(--color-border); background: var(--color-card, var(--color-bg));
    text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .svc-sc-card:hover { transform: translateY(-4px); box-shadow: 0 24px 52px -22px rgba(0, 0, 0, 0.45); border-color: color-mix(in srgb, var(--t-primary) 40%, var(--color-border)); }

  .svc-sc-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .svc-sc-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .svc-sc-card:hover .svc-sc-img { transform: scale(1.06); }
  .svc-sc-fallback { position: absolute; inset: 0; background: linear-gradient(155deg, var(--t-secondary) 0%, var(--t-bg-inverse) 100%); }
  .svc-sc-tag {
    position: absolute; top: 0.8rem; left: 0.8rem; z-index: 2;
    font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    color: #fff; background: color-mix(in srgb, var(--t-primary) 90%, transparent); padding: 0.15rem 0.5rem; border-radius: 999px;
  }

  .svc-sc-body { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.15rem 1.25rem 1.35rem; flex: 1; }
  .svc-sc-title { margin: 0; font-size: 1.2rem; font-weight: 700; line-height: 1.25; }
  .svc-sc-desc { margin: 0; font-size: 0.9rem; line-height: 1.5; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .svc-sc-arrow { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.35rem; font-size: 0.85rem; font-weight: 700; color: var(--color-primary); }
  .svc-sc-arrow svg { width: 1rem; height: 1rem; transition: transform 0.2s ease; }
  .svc-sc-card:hover .svc-sc-arrow svg { transform: translateX(4px); }
</style>
