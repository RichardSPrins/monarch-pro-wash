---
import { getServiceAreas } from "@/lib/content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@/components/blocks/tabs";

/**
 * service-areas:tabs — cities grouped into tabs by `county` (cities without a
 * county fall under "All"). Clicking a county tab reveals that county's cities
 * as a grid. The first tab is active on load. If `hrefBase` is set, city cards
 * link to `${hrefBase}/${slug}`.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    featuredOnly?: boolean;
    limit?: number;
    hrefBase?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const all = await getServiceAreas();
let areas = all.sort((a, b) => a.data.order - b.data.order);
if (data?.featuredOnly) areas = areas.filter((a) => a.data.featured);
if (data?.limit) areas = areas.slice(0, data.limit);

const hrefBase = data?.hrefBase?.replace(/\/$/, "");

// Group cities by county (fallback "All"), preserving order-sorted insertion.
const groups = new Map<string, typeof areas>();
for (const area of areas) {
  const key = area.data.county ? `${area.data.county} County` : "All";
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(area);
}
const counties = [...groups.entries()].map(([name, cities]) => ({ name, cities }));
---

{
  areas.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Header */}
        <div class="flex flex-col items-center text-center gap-sm mb-10">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <div>
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              </div>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
          )}
        </div>

        {/* Tabs */}
        <Tabs defaultValue="cty-0" class="w-full">
          <TabsList class="flex-wrap">
            {counties.map((county, i) => (
              <TabsTrigger value={`cty-${i}`}>{county.name}</TabsTrigger>
            ))}
          </TabsList>

          {counties.map((county, i) => (
            <TabsContent value={`cty-${i}`}>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-md">
                {county.cities.map((area) => {
                  const label = `${area.data.city}, ${area.data.state}`;
                  const inner = (
                    <>
                      <span class="area-pin" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                          <circle cx="12" cy="10" r="3" />
                        </svg>
                      </span>
                      <span class="flex flex-col">
                        <span class="theme-heading font-semibold leading-tight">
                          {area.data.city}
                        </span>
                        <span class="theme-text-subtle text-xs">{area.data.state}</span>
                      </span>
                    </>
                  );
                  return hrefBase ? (
                    <a
                      href={`${hrefBase}/${area.data.slug}`}
                      aria-label={label}
                      class="area-card hover:shadow-md transition-all"
                    >
                      {inner}
                    </a>
                  ) : (
                    <div class="area-card">{inner}</div>
                  );
                })}
              </div>
            </TabsContent>
          ))}
        </Tabs>

        {/* Optional CTA */}
        {data?.cta && (
          <div class="flex justify-center mt-10">
            <a
              href={data.cta.href}
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-sm transition-colors bg-primary text-primary-foreground hover:opacity-90"
            >
              {data.cta.label}
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .area-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius);
    border: var(--t-border-width) solid var(--theme-border);
    background: var(--card);
    text-decoration: none;
  }
  a.area-card:hover .area-pin {
    background: var(--color-primary);
    color: var(--color-fg-on-primary);
  }
  .area-pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .area-pin svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
