---
import { getServiceAreas } from "@/lib/content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

/**
 * service-areas:cards-detailed — larger city cards (2/3 columns) from the
 * `serviceAreas` collection. Each card shows the city name, a county/state
 * subline, an auto-generated coverage line (e.g. "Roofing services in
 * {city}, {state}"), and — when `hrefBase` is set — a "View {city}" link.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    featuredOnly?: boolean;
    limit?: number;
    hrefBase?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const business = await getBusinessData();
const serviceLabel = business.businessName ? `${business.businessName} services` : "Services";

const all = await getServiceAreas();
let areas = all.sort((a, b) => a.data.order - b.data.order);
if (data?.featuredOnly) areas = areas.filter((a) => a.data.featured);
if (data?.limit) areas = areas.slice(0, data.limit);

const hrefBase = data?.hrefBase?.replace(/\/$/, "");
---

{
  areas.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Header */}
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <div>
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              </div>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
          )}
        </div>

        {/* Cards */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {areas.map((area) => {
            const coverage = `${serviceLabel} in ${area.data.city}, ${area.data.state}`;
            return (
              <div class="detail-card">
                <div class="flex items-start gap-sm">
                  <span class="area-pin" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  </span>
                  <div class="flex flex-col">
                    <span class="theme-heading text-lg font-bold leading-tight">
                      {area.data.city}
                    </span>
                    <span class="theme-text-subtle text-xs">
                      {area.data.county ? `${area.data.county} County, ` : ""}
                      {area.data.state}
                    </span>
                  </div>
                </div>
                <p class="theme-text-muted text-sm leading-relaxed m-0">{coverage}</p>
                {hrefBase && (
                  <a
                    href={`${hrefBase}/${area.data.slug}`}
                    class="view-link text-primary text-sm font-semibold"
                  >
                    View {area.data.city}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                )}
              </div>
            );
          })}
        </div>

        {/* Optional CTA */}
        {data?.cta && (
          <div class="flex justify-center mt-10">
            <a
              href={data.cta.href}
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-sm transition-colors bg-primary text-primary-foreground hover:opacity-90"
            >
              {data.cta.label}
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .detail-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    border: var(--t-border-width) solid var(--theme-border);
    background: var(--card);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .detail-card:hover {
    box-shadow: var(--t-shadow-md);
  }
  .area-pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
  }
  .area-pin svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    text-decoration: none;
  }
  .view-link svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.2s ease;
  }
  .view-link:hover svg {
    transform: translateX(3px);
  }
</style>
