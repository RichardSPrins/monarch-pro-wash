---
import { getServices } from "@/lib/content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  CardDescription,
  CardFooter,
} from "@/components/blocks/card";
import { Button } from "@/components/elements/button";
import { Input } from "@/components/elements/input";
import { Label } from "@/components/elements/label";
import {
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem,
  SelectGroup,
} from "@/components/blocks/select";
import Textarea from "@/components/elements/textarea";

/**
 * contact:map-form — two-column section with an embedded Google Map of the
 * business address on one side and the lead form card on the other. The map is
 * a lazy-loaded iframe keyed off the composed address. Details pull from the
 * `generalSettings` singleton so the map stays in sync.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    submitLabel?: string;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();
const services = await getServices();
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const fullAddress = [
  business.address,
  [business.city, business.state].filter(Boolean).join(", "),
  business.zip,
]
  .filter(Boolean)
  .join(" ");
const mapSrc = fullAddress
  ? `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`
  : null;
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Header */}
    <div class="flex flex-col items-center text-center gap-sm mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">
      {/* Map */}
      {
        mapSrc ? (
          <div class="map-box overflow-hidden rounded-2xl border theme-border bg-bg-muted min-h-[20rem] lg:min-h-full">
            <iframe
              src={mapSrc}
              title={`Map to ${business.businessName ?? "our location"}`}
              width="100%"
              height="100%"
              style="border:0; min-height: 20rem;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        ) : (
          <div class="flex items-center justify-center rounded-2xl border theme-border bg-bg-muted min-h-[20rem] p-8 text-center">
            <p class="theme-text-muted m-0">Map location coming soon.</p>
          </div>
        )
      }

      {/* Form */}
      <Card class="bg-bg-muted on-dark">
        <CardHeader>
          <CardTitle class="text-fg">Send Us a Message</CardTitle>
          <CardDescription class="text-fg-muted">
            We'll get back to you within the hour.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form class="flex flex-col gap-md" name="contact" method="POST">
            <div class="flex flex-col gap-1.5">
              <Label for="mapform-name" class="text-fg">Full Name</Label>
              <Input type="text" id="mapform-name" name="name" placeholder="John Smith" required class="text-fg-muted placeholder:text-fg-muted border-bg-inverse" />
            </div>
            <div class="flex flex-col gap-1.5">
              <Label for="mapform-phone" class="text-fg">Phone Number</Label>
              <Input type="tel" id="mapform-phone" name="phone" placeholder="(555) 555-5555" required class="text-fg-muted placeholder:text-fg-muted border-bg-inverse" />
            </div>
            <div class="flex flex-col gap-1.5">
              <Label for="mapform-email" class="text-fg">Email</Label>
              <Input type="email" id="mapform-email" name="email" placeholder="you@example.com" class="text-fg-muted placeholder:text-fg-muted border-bg-inverse" />
            </div>
            <div class="flex flex-col gap-1.5">
              <Label for="mapform-service" class="text-fg">Service Needed</Label>
              <Select id="mapform-service" name="service">
                <SelectTrigger class="w-full text-fg-muted placeholder:text-fg-muted border-bg-inverse">
                  <SelectValue placeholder="Select a service" />
                </SelectTrigger>
                <SelectContent>
                  <SelectGroup>
                    {sortedServices.map((service) => (
                      <SelectItem value={service.data.slug}>{service.data.title}</SelectItem>
                    ))}
                  </SelectGroup>
                </SelectContent>
              </Select>
            </div>
            <div class="flex flex-col gap-1.5">
              <Label for="mapform-message" class="text-fg">Message (optional)</Label>
              <Textarea id="mapform-message" name="message" placeholder="Tell us about your project" class="text-fg-muted placeholder:text-fg-muted border-bg-inverse" />
            </div>
          </form>
        </CardContent>
        <CardFooter>
          <Button variant="primary" type="submit" class="w-full">
            {data?.submitLabel ?? "Request a Free Quote"}
          </Button>
        </CardFooter>
      </Card>
    </div>
  </div>
</section>

<style>
  .map-box iframe {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
