---
import { getHoursSettings, getServices } from "@/lib/content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, FormConfig } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import FormRenderer from "@/components/forms/FormRenderer.astro";

/**
 * contact:split — lead form on one side, a stacked info block (phone, email,
 * address + hours table) on the other. A layout variant of contact:form that
 * leads with the form and consolidates the business details into a bordered
 * "how to reach us" panel. Details pull from the `generalSettings` +
 * `hoursSettings` singletons so they stay in sync.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    showHours?: boolean;
    formTitle?: string;
    formDescription?: string;
    submitLabel?: string;
    /** Optional form config (type, title, submit target) — see FormConfig. */
    form?: FormConfig;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();
const services = await getServices();
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const showHours = data?.showHours ?? true;
const hoursEntries = showHours ? await getHoursSettings() : [];
const hours = hoursEntries[0]?.data.hours ?? [];

const fullAddress = [
  business.address,
  [business.city, business.state].filter(Boolean).join(", "),
  business.zip,
]
  .filter(Boolean)
  .join(" ");
const telHref = business.phone ? `tel:${business.phone.replace(/[^\d+]/g, "")}` : null;
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Header */}
    <div class="flex flex-col items-center text-center gap-sm mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      {/* Form — delegated to the shared lead form so submissions actually deliver.
          Same defect as contact:form previously had: a bare <form> with no action
          and no submit script, with the submit Button outside the <form>. */}
      <FormRenderer
        form={{
          ...(data?.form ?? {}),
          title: data?.form?.title ?? data?.formTitle,
          description: data?.form?.description ?? data?.formDescription,
          submitLabel: data?.form?.submitLabel ?? data?.submitLabel,
        }}
        services={sortedServices}
      />

      {/* Info block */}
      <div class="flex flex-col gap-lg lg:pt-2">
        {
          telHref && (
            <a href={telHref} class="flex items-start gap-md no-underline group">
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </span>
              <span class="flex flex-col min-w-0">
                <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Call us</span>
                <span class="theme-heading text-base sm:text-lg font-semibold break-words group-hover:text-primary transition-colors">
                  {business.phone}
                </span>
              </span>
            </a>
          )
        }
        {
          business.email && (
            <a href={`mailto:${business.email}`} class="flex items-start gap-md no-underline group">
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-10 6L2 7" />
                </svg>
              </span>
              <span class="flex flex-col min-w-0">
                <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Email</span>
                <span class="theme-heading text-base sm:text-lg font-semibold break-words group-hover:text-primary transition-colors">
                  {business.email}
                </span>
              </span>
            </a>
          )
        }
        {
          fullAddress && (
            <div class="flex items-start gap-md">
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <span class="flex flex-col min-w-0">
                <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Visit</span>
                <span class="theme-text text-lg">{fullAddress}</span>
              </span>
            </div>
          )
        }

        {
          hours.length > 0 && (
            <div class="mt-2 rounded-xl border theme-border p-5">
              <h3 class="theme-heading text-sm font-semibold uppercase tracking-widest m-0 mb-3">Hours</h3>
              <dl class="flex flex-col gap-1.5 m-0">
                {hours.map((h: any) => (
                  <div class="flex items-center justify-between gap-md text-sm">
                    <dt class="theme-text-muted m-0">{h.day}</dt>
                    <dd class="theme-text font-medium m-0">
                      {h.closedAllDay ? "Closed" : `${h.open} – ${h.close}`}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
  }
  .contact-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
