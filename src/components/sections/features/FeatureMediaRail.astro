---
import type {
  Eyebrow,
  FeatureItem,
  ImageRef,
  SectionCTA,
  StatItem,
} from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * feature:media-rail — a two-column feature block: a compact feature list on one
 * side and a media rail on the other (an image with a raised stats card floating
 * over its lower edge). `imagePosition` flips which side the rail sits on. The
 * stats card is a guaranteed-light surface so its numbers stay legible on any
 * theme.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: FeatureItem[];
    stats?: StatItem[];
    image?: ImageRef;
    imagePosition?: "left" | "right";
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;
const items = data?.items ?? [];
const stats = data?.stats ?? [];
const imagePosition = data?.imagePosition ?? "right";
const railOrderClass = imagePosition === "left" ? "lg:order-1" : "lg:order-2";
const contentOrderClass = imagePosition === "left" ? "lg:order-2" : "lg:order-1";

const iconPaths: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  star: '<path d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.8 6.2 21.9l1.1-6.5L2.6 9.8l6.5-.9L12 3z"/>',
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/>',
  wrench: '<path d="M14.5 6.5a4 4 0 0 0-5 5L3 18l3 3 6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z"/>',
  droplet: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  dollar: '<path d="M12 2v20"/><path d="M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.6 7 6.5 9.2 9.5 12 9.5s5 1.1 5 3-2.2 3-5 3-5-1.1-5-3"/>',
  check:
    '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
};

const hasRail = data?.image || stats.length > 0;

// The checklist is optional. Gating the whole section on `items` meant a section
// with a real heading, image and stats rendered as nothing at all the moment the
// list was empty — which is how the homepage lost this band entirely.
const hasContent = items.length > 0 || hasRail || Boolean(data?.heading || data?.subheading);
---

{
  hasContent && (
    <section
      class:list={["feature-media-rail section-wrapper section-py", `theme-${theme}`]}
    >
      <div class="section-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          {/* Content + feature list */}
          <div class:list={["flex flex-col gap-lg", contentOrderClass]}>
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <div>
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                </div>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg leading-relaxed m-0">
                {data.subheading}
              </p>
            )}

            <ul class="flex flex-col gap-5 list-none m-0 p-0 mt-1" hidden={items.length === 0}>
              {items.map((item) => (
                <li class="flex items-start gap-md">
                  <span class="rail-icon" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <Fragment
                        set:html={iconPaths[item.icon ?? ""] ?? iconPaths.check}
                      />
                    </svg>
                  </span>
                  <div class="flex flex-col gap-1">
                    <h3 class="theme-heading text-base font-semibold m-0">
                      {item.title}
                    </h3>
                    {item.body && (
                      <p class="theme-text-muted text-sm leading-relaxed m-0">
                        {item.body}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>

            {data?.cta && (
              <div class="mt-2">
                <Button
                  variant={data.cta.variant ?? "primary"}
                  href={data.cta.href}
                >
                  {data.cta.label}
                </Button>
              </div>
            )}
          </div>

          {/* Media rail */}
          {hasRail && (
            <div class:list={["media-rail relative", railOrderClass]}>
              {data?.image && (
                <div class="rail-image">
                  <SmartImage
                    src={data.image.src}
                    alt={data.image.alt ?? ""}
                    widths={[480, 768, 1024]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}
              {stats.length > 0 && (
                <div
                  class:list={[
                    "surface-base rail-stats",
                    data?.image
                      ? "sm:absolute sm:-bottom-6 sm:left-6 sm:right-6"
                      : "",
                  ]}
                >
                  <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-lg gap-y-md m-0">
                    {stats.map((stat) => (
                      <div class="flex flex-col gap-0.5">
                        <dt class="rail-stat-value">{stat.value}</dt>
                        <dd class="theme-text-muted text-xs leading-snug m-0">
                          {stat.label}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .rail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
    color: var(--theme-accent);
  }

  .rail-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .rail-image {
    position: relative;
    border-radius: var(--t-radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--t-shadow-md);
  }

  .rail-image :global(img) {
    border-radius: var(--t-radius);
  }

  .rail-stats {
    padding: 1.25rem 1.5rem;
    border-radius: var(--t-radius);
    border: var(--t-border-width) solid var(--theme-border);
    box-shadow: var(--t-shadow-lg);
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .media-rail:has(.rail-image) {
      margin-bottom: 2.5rem;
    }
    .rail-stats {
      margin-top: 0;
    }
  }

  .rail-stat-value {
    color: var(--theme-accent);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
</style>
