---
import { getReviews } from "@/lib/content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    filter?: "featured" | "all";
    service?: string;
  };
}

const { theme = "default", data } = Astro.props;

const business = await getBusinessData();
const allReviews = await getReviews();

const reviews = allReviews
  .filter((r) => (data?.filter === "all" ? true : r.data.featured))
  .filter((r) => !data?.service || r.data.service === data.service)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, data?.limit ?? 6);

// Split into 3 columns for masonry
const columns: (typeof reviews)[] = [[], [], []];
reviews.forEach((review, i) => columns[i % 3].push(review));

function getInitials(name: string) {
  return name
    .split(" ")
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
}

const sourceColors: Record<string, string> = {
  Google: "#EA4335",
  Facebook: "#1877F2",
  Yelp: "#D32323",
  Direct: "#1b4332",
};
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Section header */}
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    {/* Masonry grid — 3 columns */}
    {
      reviews.length > 0 ? (
        <div class="masonry-grid">
          {columns.map((column) => (
            <div class="masonry-col">
              {column.map((review) => {
                const stars = Array.from(
                  { length: 5 },
                  (_, i) => i < review.data.rating
                );
                const initials = getInitials(review.data.author);
                const sourceColor =
                  sourceColors[review.data.source] ?? sourceColors.Direct;

                return (
                  <div class="review-card">
                    {/* Card header */}
                    <div class="flex items-start justify-between gap-sm mb-4">
                      <div class="flex items-center gap-sm">
                        {/* Avatar */}
                        <div
                          class="avatar"
                          style={`background: ${sourceColor}18; color: ${sourceColor};`}
                        >
                          {initials}
                        </div>

                        {/* Author info */}
                        <div class="flex flex-col gap-0.5">
                          <span class="theme-heading font-semibold text-sm leading-tight">
                            {review.data.author}
                          </span>
                          {review.data.location && (
                            <span class="theme-text-subtle text-xs">
                              {review.data.location}
                            </span>
                          )}
                        </div>
                      </div>

                      {/* Source badge */}
                      <div
                        class="source-icon shrink-0"
                        title={review.data.source}
                      >
                        {review.data.source === "Google" && (
                          <svg
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-label="Google"
                          >
                            <path
                              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                              fill="#4285F4"
                            />
                            <path
                              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                              fill="#34A853"
                            />
                            <path
                              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                              fill="#FBBC05"
                            />
                            <path
                              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                              fill="#EA4335"
                            />
                          </svg>
                        )}
                        {review.data.source === "Facebook" && (
                          <svg
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-label="Facebook"
                          >
                            <path
                              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                              fill="#1877F2"
                            />
                          </svg>
                        )}
                        {review.data.source === "Yelp" && (
                          <svg
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-label="Yelp"
                          >
                            <path
                              d="M20.16 12.73l-4.703 1.14c-.103.025-.198.077-.277.149a.644.644 0 0 0-.183.267.624.624 0 0 0-.028.32c.02.108.066.21.134.296l3.028 3.78c.067.084.153.151.25.197a.672.672 0 0 0 .635-.033.643.643 0 0 0 .24-.252c.47-.878.801-1.821.982-2.797a9.123 9.123 0 0 0-.078-3.067z"
                              fill="#D32323"
                            />
                            <path
                              d="M12.77 11.33l4.31-2.217a.633.633 0 0 0 .237-.208.61.61 0 0 0 .1-.308.617.617 0 0 0-.072-.32.637.637 0 0 0-.22-.243 9.284 9.284 0 0 0-5.448-1.49.636.636 0 0 0-.417.183.614.614 0 0 0-.183.414l-.068 4.806c-.002.11.026.219.08.315a.63.63 0 0 0 .216.231.652.652 0 0 0 .617.033.633.633 0 0 0 .248-.196z"
                              fill="#D32323"
                            />
                          </svg>
                        )}
                        {review.data.source === "Direct" && (
                          <svg
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            stroke="var(--color-primary)"
                            stroke-width="2"
                            aria-label="Direct"
                          >
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                          </svg>
                        )}
                      </div>
                    </div>

                    {/* Stars */}
                    <div class="flex items-center gap-0.5 mb-3">
                      {stars.map((filled) => (
                        <svg
                          class={`w-4 h-4 ${filled ? "star-filled" : "star-empty"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                        </svg>
                      ))}
                    </div>

                    {/* Review body */}
                    <p class="review-body theme-text">{review.data.body}</p>

                    {/* Footer — service tag + date */}
                    <div class="review-footer">
                      {review.data.service && (
                        <span class="service-tag">
                          {review.data.service.replace(/-/g, " ")}
                        </span>
                      )}
                      <span class="review-date theme-text-subtle">
                        {review.data.date.toLocaleDateString("en-US", {
                          month: "short",
                          year: "numeric",
                        })}
                      </span>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center theme-text-muted">No reviews yet.</p>
      )
    }

    {/* GBP link */}
    {
      business.gbpUrl && (
        <div class="flex flex-col items-center gap-xs mt-12">
          <div class="flex items-center gap-1.5">
            {Array.from({ length: 5 }).map(() => (
              <svg
                class="w-5 h-5 star-filled"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>
          <a
            href={business.gbpUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-xs text-sm font-semibold text-primary hover:underline"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                fill="#4285F4"
              />
              <path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                fill="#34A853"
              />
              <path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                fill="#FBBC05"
              />
              <path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                fill="#EA4335"
              />
            </svg>
            Read all our reviews on Google
            <svg
              class="w-3.5 h-3.5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Masonry layout */
  .masonry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .masonry-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .masonry-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Review card */
  .review-card {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--t-border);
    background: var(--color-bg);
    /* The card is always the dark base surface, so pin on-dark text tokens here.
       Otherwise a light section (theme="alt") renders the text dark-on-dark. */
    --theme-fg: var(--t-fg);
    --theme-heading: var(--t-fg);
    --theme-fg-muted: var(--t-fg-muted);
    --theme-fg-subtle: var(--t-fg-subtle);
    color: var(--t-fg);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .review-card:hover {
    box-shadow: var(--t-shadow-sm);
    transform: translateY(-2px);
  }

  /* Avatar */
  .avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Source icon */
  .source-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .source-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Stars */
  .star-filled {
    color: var(--color-brand-secondary);
  }

  .star-empty {
    color: var(--color-fg-subtle);
    opacity: 0.3;
  }

  /* Review body */
  .review-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  /* Footer */
  .review-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border-muted);
  }

  .service-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--theme-accent) 8%, transparent);
    color: var(--theme-accent);
  }

  .review-date {
    font-size: 0.75rem;
  }
</style>
