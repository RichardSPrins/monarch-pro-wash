---
import { getReviews } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    filter?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getReviews();

const reviews = allReviews
  .filter((r) => (data?.filter === "featured" ? r.data.featured : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, data?.limit ?? allReviews.length);

const [featured, ...rest] = reviews;
---

{
  featured && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Split layout */}
        <div class="split-grid">
          {/* Left — large featured review */}
          <div class="featured-card">
            {/* Decorative quote mark */}
            <div class="quote-mark" aria-hidden="true">
              "
            </div>

            {/* Stars */}
            <div class="flex items-center gap-1 mb-4">
              {Array.from({ length: 5 }, (_, i) => i < featured.data.rating).map(
                (filled) => (
                  <svg
                    class={`w-5 h-5 ${filled ? "star-filled" : "star-empty"}`}
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                )
              )}
            </div>

            {/* Body */}
            <blockquote class="featured-body theme-text">
              {featured.data.body}
            </blockquote>

            {/* Author */}
            <div class="featured-author">
              <span class="theme-heading font-bold text-base leading-tight">
                {featured.data.author}
              </span>
              {featured.data.location && (
                <span class="theme-text-muted text-sm">
                  {featured.data.location}
                </span>
              )}
            </div>
          </div>

          {/* Right — compact list of remaining reviews */}
          {rest.length > 0 && (
            <div class="review-list">
              {rest.map((review) => {
                const stars = Array.from(
                  { length: 5 },
                  (_, i) => i < review.data.rating
                );

                return (
                  <div class="list-item">
                    {/* Stars */}
                    <div class="flex items-center gap-0.5 mb-2">
                      {stars.map((filled) => (
                        <svg
                          class={`w-3.5 h-3.5 ${filled ? "star-filled" : "star-empty"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                        </svg>
                      ))}
                    </div>

                    {/* Body — clamped */}
                    <p class="list-body theme-text">{review.data.body}</p>

                    {/* Author */}
                    <div class="list-author">
                      <span class="theme-heading font-semibold text-sm leading-tight">
                        {review.data.author}
                      </span>
                      {review.data.location && (
                        <span class="theme-text-subtle text-xs">
                          {review.data.location}
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Split layout */
  .split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .split-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  /* Featured card */
  .featured-card {
    position: relative;
    padding: 2.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
  }

  /* Decorative large quote mark */
  .quote-mark {
    position: absolute;
    top: -1rem;
    right: 1.5rem;
    font-size: 10rem;
    font-family: Georgia, serif;
    line-height: 1;
    color: var(--theme-accent);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }

  .featured-body {
    font-size: clamp(1.0625rem, 2vw, 1.375rem);
    line-height: 1.7;
    font-style: italic;
    margin: 0 0 2rem 0;
    position: relative;
    z-index: 1;
  }

  .featured-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  /* Compact vertical list */
  .review-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .list-item {
    padding: 1.125rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .list-item:hover {
    box-shadow: var(--t-shadow-sm);
    transform: translateY(-2px);
  }

  .list-body {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .list-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  /* Stars */
  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-fg-subtle);
    opacity: 0.3;
  }
</style>
