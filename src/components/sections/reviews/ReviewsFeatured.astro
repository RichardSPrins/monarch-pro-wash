---
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    author: string;
    role?: string;
    location?: string;
    body: string;
    rating?: number;
    image?: { src: string; alt?: string };
    source?: "Google" | "Facebook" | "Yelp" | "Direct";
  };
}

const { theme = "default", data } = Astro.props;
const rating = data?.rating ?? 5;
const stars = Array.from({ length: 5 }, (_, i) => i < rating);
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Optional header */}
    {
      (data?.eyebrow || data?.heading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
        </div>
      )
    }

    {/* Featured review card */}
    <div class="review-card theme-default">
      {/* Left — person image */}
      <div class="review-image-wrapper">
        {
          data?.image ? (
            <SmartImage
              src={data.image.src}
              alt={data.image.alt ?? data?.author ?? "Reviewer"}
              widths={[400, 640]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="review-image"
            />
          ) : (
            <div class="review-image-fallback">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
              </svg>
            </div>
          )
        }

        {/* Source badge */}
        {
          data?.source && data.source !== "Direct" && (
            <div class="source-badge">
              {data.source === "Google" && (
                <svg
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-label="Google review"
                >
                  <path
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                    fill="#34A853"
                  />
                  <path
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                    fill="#FBBC05"
                  />
                  <path
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                    fill="#EA4335"
                  />
                </svg>
              )}
              {data.source === "Facebook" && (
                <svg
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-label="Facebook review"
                >
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    fill="#1877F2"
                  />
                </svg>
              )}
            </div>
          )
        }
      </div>

      {/* Right — review content */}
      <div class="review-content">
        {/* Decorative quote mark */}
        <div class="quote-mark" aria-hidden="true">"</div>

        {/* Stars */}
        <div class="flex items-center gap-1 mb-4">
          {
            stars.map((filled) => (
              <svg
                class={`w-5 h-5 ${filled ? "text-[var(--color-rating)]" : "text-[var(--color-rating-empty)]"}`}
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))
          }
        </div>

        {/* Review body */}
        <blockquote class="review-body theme-text">
          {data?.body}
        </blockquote>

        {/* Author info */}
        <div class="review-author">
          <div class="flex flex-col gap-0.5">
            <span class="theme-heading font-bold text-base">
              {data?.author}
            </span>
            {
              (data?.role || data?.location) && (
                <span class="theme-text-muted text-sm">
                  {[data.role, data.location].filter(Boolean).join(" · ")}
                </span>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .review-card {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: var(--t-shadow-lg);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .review-card {
      grid-template-columns: 280px 1fr;
    }
  }

  /* Left image panel */
  .review-image-wrapper {
    position: relative;
    min-height: 280px;
    background: var(--color-bg-primary);
  }

  .review-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .review-image-fallback {
    width: 100%;
    height: 100%;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-primary);
    color: rgba(255, 255, 255, 0.3);
  }

  .review-image-fallback svg {
    width: 5rem;
    height: 5rem;
  }

  /* Green gradient overlay on image */
  .review-image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      color-mix(in srgb, var(--theme-accent) 60%, transparent) 100%
    );
    pointer-events: none;
  }

  /* Source badge */
  .source-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--t-shadow-md);
    padding: 0.375rem;
  }

  .source-badge svg {
    width: 100%;
    height: 100%;
  }

  /* Right content panel */
  .review-content {
    position: relative;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-bg);
    overflow: hidden;
  }

  /* Decorative large quote mark */
  .quote-mark {
    position: absolute;
    top: -1rem;
    right: 1.5rem;
    font-size: 10rem;
    font-family: Georgia, serif;
    line-height: 1;
    color: var(--theme-accent);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }

  .review-body {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    font-style: italic;
    margin: 0 0 2rem 0;
    position: relative;
    z-index: 1;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
</style>
