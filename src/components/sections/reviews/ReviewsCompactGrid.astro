---
import { getReviews } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    filter?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getReviews();

const reviews = allReviews
  .filter((r) => (data?.filter === "featured" ? r.data.featured : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, data?.limit ?? allReviews.length);
---

{
  reviews.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Dense compact grid */}
        <div class="compact-grid">
          {reviews.map((review) => {
            const stars = Array.from(
              { length: 5 },
              (_, i) => i < review.data.rating
            );

            return (
              <div class="compact-card">
                {/* Stars */}
                <div class="flex items-center gap-0.5 mb-2.5">
                  {stars.map((filled) => (
                    <svg
                      class={`w-3.5 h-3.5 ${filled ? "star-filled" : "star-empty"}`}
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  ))}
                </div>

                {/* Body — line clamped */}
                <p class="compact-body theme-text">{review.data.body}</p>

                {/* Author */}
                <div class="compact-author">
                  <span class="theme-heading font-semibold text-sm leading-tight">
                    {review.data.author}
                  </span>
                  {review.data.location && (
                    <span class="theme-text-subtle text-xs">
                      {review.data.location}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Dense grid — 2 / 3 / 4 columns */
  .compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .compact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .compact-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Compact card */
  .compact-card {
    display: flex;
    flex-direction: column;
    padding: 1.125rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .compact-card:hover {
    box-shadow: var(--t-shadow-sm);
    transform: translateY(-2px);
  }

  /* Stars */
  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-fg-subtle);
    opacity: 0.3;
  }

  /* Body — clamp to ~3 lines */
  .compact-body {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 0.875rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Author */
  .compact-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-muted);
  }
</style>
