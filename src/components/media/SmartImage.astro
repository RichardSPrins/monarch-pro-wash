---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { resolveImage, isLocal, isEmdashMedia, toOptimizableMediaUrl } from "@/lib/images";

/**
 * JSON-friendly image. Takes a string `src` (from page/content JSON), resolves
 * it via the central resolver, and renders an optimized <Image> for local
 * assets or a plain <img> for public/remote URLs. Pass `fallback` (a statically
 * imported ImageMetadata) to cover missing/unset sources.
 */
interface Props {
  src?: string;
  alt?: string;
  fallback?: ImageMetadata;
  width?: number;
  /** Intrinsic height. Supply alongside `width` for CMS media to skip inferSize. */
  height?: number;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  src,
  alt = "",
  fallback,
  width,
  height,
  widths,
  sizes,
  class: className,
  loading = "lazy",
  fetchpriority,
} = Astro.props;

const resolved = resolveImage(src) ?? fallback;

// CMS media lives in R2 and IS optimizable — EmDash's image endpoint resizes it
// from the bucket. Astro only engages for an absolute URL matching its remote
// patterns, so absolutize first. Known dimensions avoid inferSize, which would
// otherwise have to read the bytes just to learn the aspect ratio.
const cmsSrc =
  typeof resolved === "string" && isEmdashMedia(resolved)
    ? toOptimizableMediaUrl(resolved)
    : null;

// A remote image needs either both intrinsic dimensions or inferSize, which
// reads them from the bytes.
const cmsDims =
  width && height ? { width, height } : ({ inferSize: true } as const);
---

{
  isLocal(resolved) ? (
    <Image
      src={resolved}
      alt={alt}
      width={width}
      widths={widths}
      sizes={sizes}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  ) : cmsSrc ? (
    <Image
      src={cmsSrc}
      alt={alt}
      {...cmsDims}
      widths={widths}
      sizes={sizes}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  ) : resolved ? (
    <img
      src={resolved}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  ) : null
}
