---
import SectionList from "@/components/SectionList.astro";
import type { SectionConfig } from "@/types/sections";

/**
 * Renders a page from its ordered `sections` array.
 *
 * Default ("stack") mode renders every section as a full-width sibling — the
 * original behaviour, unchanged.
 *
 * "rail" mode splits the page into three runs so a sticky sidebar can sit
 * alongside the body without the hero or the closing CTA being boxed in:
 *
 *     hero(s)                              full bleed
 *     ┌──────────────────────────────────────────────┐
 *     │  main: everything between   │  aside: rail   │
 *     └──────────────────────────────────────────────┘
 *     trailing cta(s)                      full bleed
 *
 * The rail is passed as a named slot, so it can hold real components (a form,
 * a service list) rather than the flat link/CTA data `content:sidebar` allows.
 * Pass `layout="rail"` AND a `rail` slot; with no slot content the page falls
 * back to a plain stack so a missing rail can't produce an empty column.
 */
interface Props {
  config: {
    sections: SectionConfig[];
  };
  layout?: "stack" | "rail";
}

const { config, layout = "stack" } = Astro.props;

const sections = config.sections ?? [];
const hasRail = layout === "rail" && Astro.slots.has("rail");

/** Sections that must span the full viewport width, never the content column. */
const isLeadingFullBleed = (s: SectionConfig) => s.type?.startsWith("hero:");
const isTrailingFullBleed = (s: SectionConfig) => s.type?.startsWith("cta:");

// Leading heroes, then the body, then any trailing CTA band. Computed by
// walking in from each end so a page with an unusual order still splits safely.
let start = 0;
let end = sections.length;
if (hasRail) {
  while (start < end && isLeadingFullBleed(sections[start])) start++;
  while (end > start && isTrailingFullBleed(sections[end - 1])) end--;
}

const lead = hasRail ? sections.slice(0, start) : [];
const body = hasRail ? sections.slice(start, end) : sections;
const tail = hasRail ? sections.slice(end) : [];
---

{hasRail ? (
  <>
    <SectionList sections={lead} />
    <div class="page-shell">
      <div class="page-main">
        <SectionList sections={body} />
      </div>
      {/* Container-aligned track the rail travels in. Above xl it is absolutely
          positioned over the section run, so the sections stay in normal flow and
          their backgrounds still reach the viewport edges. */}
      <div class="page-rail">
        <div class="page-rail-inner">
          <aside class="page-aside">
            <slot name="rail" />
          </aside>
        </div>
      </div>
    </div>
    <SectionList sections={tail} />
  </>
) : (
  <SectionList sections={body} />
)}

<style is:global>
  /* Sticky-rail page shell, for service and service-in-area pages.
     ---------------------------------------------------------------------------
     The sections stay in NORMAL FLOW so their theme bands still reach both
     viewport edges, exactly as on any other page. The rail is laid over them in
     a container-aligned track rather than taking a grid column — a grid column
     would confine the bands to it and reintroduce the gutters.

     Two earlier attempts got this wrong in opposite directions: first boxing the
     shell to 72rem on a light background (a white panel floating on the dark
     page), then removing `max-width` from the nested .section-container (content
     stopped respecting the site container). Neither is the case now: the shell is
     invisible, and .section-container keeps its canonical 72rem. */
  .page-shell {
    position: relative;
  }
  .page-main { min-width: 0; }

  /* Sections behave here exactly as they do anywhere else on the site: each one
     paints its own full-width band from its theme, and the rhythm (white, grey,
     navy, plus the bold CTA) comes from the section data. The rail is laid over
     the top; it does not change how sections work.

     The only addition is a second light tone, so consecutive light sections
     alternate white/grey rather than reading as one flat slab. Scoped to
     .theme-alt deliberately — a theme-* class sets text colour as well as
     background, so repainting a navy section light would leave light-on-light
     text. */
  .page-main > .section-wrapper.theme-alt:nth-of-type(even) {
    background-color: var(--t-bg-alt-2);
  }

  /* The track is transparent — it is only a positioning device. The rail reads
     as floating cards over whatever band happens to be behind them, so the
     cards carry their own surface (see ServicePageRail).

     Below xl the rail flows after the content as a normal block, with spacing
     on ALL FOUR sides — the top included, which is what was missing against the
     preceding section. */
  .page-rail {
    padding-inline: 1rem;
  }
  .page-rail-inner {
    padding-block: 2.5rem;
  }

  @media (min-width: 640px) {
    .page-rail { padding-inline: 1.5rem; }
  }

  @media (min-width: 1280px) {
    /* The track spans the whole section run and is aligned to the SITE container
       (72rem + its 2rem gutter), so the rail's right edge lines up with the
       header and footer. pointer-events are released so the track can't swallow
       clicks on the content it overlays. */
    .page-rail {
      position: absolute;
      inset: 0;
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: 2rem;
      pointer-events: none;
    }
    .page-rail-inner {
      width: 20rem;
      margin-left: auto;
      min-height: 100%;
      padding-block: 0;
    }
    .page-aside {
      position: sticky;
      /* Clear the sticky header. `top: 1.5rem` put the rail underneath it. */
      top: calc(var(--site-header-h) + 1.5rem);
      max-height: calc(100vh - var(--site-header-h) - 5rem);
      overflow-y: auto;
      overscroll-behavior-y: contain;
      /* The rail scrolls often; keep the scrollbar unobtrusive. */
      scrollbar-width: thin;
      pointer-events: auto;
    }

    /* NOTE: do NOT neutralise section backgrounds here. The theme-* classes set
       background AND text colour together, so stripping the background leaves a
       light surface's dark ink sitting on the page's dark body — unreadable.

       And do NOT override .section-container's max-width. It stays at the
       canonical 72rem; the copy is kept clear of the overlaid rail with padding
       instead (rail 20rem + 3rem gap + the container's own 2rem gutter). */
    .page-main .section-container {
      padding-right: calc(20rem + 3rem + 2rem);
    }

    /* The rail takes 20rem out of the container, leaving ~45rem of copy. Grid
       utilities inside the sections still key off the VIEWPORT, so a four-up
       grid kept four columns in 45rem — about 180px each, which broke headings
       like "Surface-matched cleaning" over three lines. Halve the densest
       grids to match the width that's actually available. */
    .page-main [class*="lg:grid-cols-4"],
    .page-main [class*="lg:grid-cols-5"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
