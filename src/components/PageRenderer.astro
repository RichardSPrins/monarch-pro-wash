---
import SectionList from "@/components/SectionList.astro";
import type { SectionConfig } from "@/types/sections";

/**
 * Renders a page from its ordered `sections` array.
 *
 * Default ("stack") mode renders every section as a full-width sibling — the
 * original behaviour, unchanged.
 *
 * "rail" mode splits the page into three runs so a sticky sidebar can sit
 * alongside the body without the hero or the closing CTA being boxed in:
 *
 *     hero(s)                              full bleed
 *     ┌──────────────────────────────────────────────┐
 *     │  main: everything between   │  aside: rail   │
 *     └──────────────────────────────────────────────┘
 *     trailing cta(s)                      full bleed
 *
 * The rail is passed as a named slot, so it can hold real components (a form,
 * a service list) rather than the flat link/CTA data `content:sidebar` allows.
 * Pass `layout="rail"` AND a `rail` slot; with no slot content the page falls
 * back to a plain stack so a missing rail can't produce an empty column.
 */
interface Props {
  config: {
    sections: SectionConfig[];
  };
  layout?: "stack" | "rail";
}

const { config, layout = "stack" } = Astro.props;

const sections = config.sections ?? [];
const hasRail = layout === "rail" && Astro.slots.has("rail");

/** Sections that must span the full viewport width, never the content column. */
const isLeadingFullBleed = (s: SectionConfig) => s.type?.startsWith("hero:");
const isTrailingFullBleed = (s: SectionConfig) => s.type?.startsWith("cta:");

// Leading heroes, then the body, then any trailing CTA band. Computed by
// walking in from each end so a page with an unusual order still splits safely.
let start = 0;
let end = sections.length;
if (hasRail) {
  while (start < end && isLeadingFullBleed(sections[start])) start++;
  while (end > start && isTrailingFullBleed(sections[end - 1])) end--;
}

const lead = hasRail ? sections.slice(0, start) : [];
const body = hasRail ? sections.slice(start, end) : sections;
const tail = hasRail ? sections.slice(end) : [];
---

{hasRail ? (
  <>
    <SectionList sections={lead} />
    <div class="page-shell">
      <div class="page-main">
        <SectionList sections={body} />
      </div>
      <aside class="page-aside">
        <slot name="rail" />
      </aside>
    </div>
    <SectionList sections={tail} />
  </>
) : (
  <SectionList sections={body} />
)}

<style is:global>
  /* Two-column page shell with a sticky rail, for service and service-in-area
     pages. Single column until xl: a 20rem rail plus readable body copy needs
     more than 1024px, and the rail's content is supplementary on mobile — it is
     rendered after the body in that case rather than pushed above it.

     The rail gets its own scroll so a long list can never trap the page: it is
     capped to the viewport and scrolls internally, with overscroll containment
     so reaching its end doesn't start scrolling the page behind it. */
  /* The shell itself is INVISIBLE: no background, no max-width, no side padding.
     An earlier version boxed it to 72rem on a light background, which read as a
     white panel floating on the dark page with wide dark gutters. Sections keep
     painting their own full-width bands, exactly as they do on a normal page;
     the shell only reserves a column for the rail. */
  .page-shell {
    display: grid;
    grid-template-columns: 1fr;
  }
  .page-main { min-width: 0; }
  .page-aside { min-width: 0; }

  /* Below xl the rail is a normal block after the content, so it needs its own
     breathing room rather than butting into the next full-width band. */
  .page-aside {
    padding: 0 1rem 3rem;
  }

  @media (min-width: 1280px) {
    .page-shell {
      grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: 3rem;
      /* Keeps the rail off the viewport edge without indenting the bands. */
      padding-right: 2rem;
    }
    .page-aside {
      position: sticky;
      /* Clear the sticky header. `top: 1.5rem` put the rail underneath it. */
      top: calc(var(--site-header-h) + 1.5rem);
      align-self: start;
      /* Leave a gap at the foot so the card never kisses the next section. */
      max-height: calc(100vh - var(--site-header-h) - 4rem);
      overflow-y: auto;
      overscroll-behavior-y: contain;
      /* The rail scrolls often; keep the scrollbar unobtrusive. */
      scrollbar-width: thin;
      padding: 0 0 2rem;
      margin-bottom: 3rem;
    }
    /* NOTE: do NOT neutralise section backgrounds here. The theme-* classes set
       background AND text colour together, so stripping the background leaves a
       light surface's dark ink sitting on the page's dark body — unreadable.
       Sections paint their own surface; the rhythm is chosen in the template. */

    /* Sections sit in the main column, so their container should fill it rather
       than re-centre at 72rem and strand the copy away from the rail. */
    .page-main .section-container {
      max-width: none;
    }
  }
</style>
