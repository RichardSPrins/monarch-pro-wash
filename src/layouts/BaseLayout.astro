---
import "@/styles/starwind.css";
import "../styles/global.css";
import SEO from "@/components/seo/SEO.astro";
import JsonLd from "@/components/seo/JsonLD.astro";
import Analytics from "@/components/layout/Analytics.astro";
import ConsentBanner from "@/components/layout/ConsentBanner.astro";
import { ClientRouter } from "astro:transitions";
import {
  createWebsiteSchema,
  createLocalBusinessSchema,
  createBlogPostSchema,
  createBreadcrumbSchema,
} from "@/lib/schema";
import type {
  WithContext,
  WebSite,
  LocalBusiness,
  BlogPosting,
  Service,
  FAQPage,
  BreadcrumbList,
} from "schema-dts";
import siteConfig from "@/config/site.config";
import { getBusinessData, getSiteData } from "@/lib/utils";
import { getSiteSetting } from "emdash";
import { WidgetArea } from "emdash/ui";

interface Props {
  page: {
    id: string;
    data: Record<string, any>;
  };

  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeLocalBusinessSchema?: boolean;
  includeBlogSchema?: boolean;
  businessType?: string;
  openingHours?: string[];
  areaServed?: string[];
  /** Override the canonical URL for this page. */
  canonical?: string;
  /** Extra per-page JSON-LD (e.g. Service, FAQPage) appended to the site schemas. */
  schemas?: WithContext<Service | FAQPage | LocalBusiness>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  nofollow = false,
  includeLocalBusinessSchema = false,
  includeBlogSchema = false,
  businessType,
  openingHours,
  areaServed,
  canonical,
  schemas: extraSchemas = [],
  page,
} = Astro.props;

const business = await getBusinessData();
const site = getSiteData();
// Native SiteSettings SEO block (search-console verification codes). Emitted only
// when an editor has filled them in the native Settings panel.
const seoSettings = await getSiteSetting("seo");

let ogImage: string;
if (image) {
  ogImage = image.startsWith("http")
    ? image
    : new URL(image, Astro.site).toString();
} else {
  ogImage = new URL(siteConfig.ogImage, Astro.site).toString();
}

const schemas: WithContext<
  WebSite | LocalBusiness | BlogPosting | Service | FAQPage | BreadcrumbList
>[] = [createWebsiteSchema(business, site)];

if (includeLocalBusinessSchema) {
  schemas.push(
    createLocalBusinessSchema(business, site, {
      businessType,
      openingHours,
      areaServed,
    })
  );
}

if (includeBlogSchema) {
  schemas.push(
    createBlogPostSchema({
      title: title ? `${title} | ${siteConfig.name}` : siteConfig.name,
      description: description ?? siteConfig.description,
      image: ogImage,
      url: `${site.url}${Astro.url.pathname}`,
      author: {
        name: article?.authors?.[0] || siteConfig.name,
      },
      datePublished: article?.publishedTime
        ? new Date(article.publishedTime)
        : new Date(),
      businessName: siteConfig.name,
      siteUrl: site.url,
    })
  );
}

// Per-page structured data (Service, FAQPage, …) built by the route.
if (extraSchemas.length) schemas.push(...extraSchemas);

const segments = page.id.split("/");
const breadcrumbItems = [
  { name: "Home", url: site.url },
  ...segments.map((segment: string, i: number) => ({
    name: segment
      .split("-")
      .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" "),
    url: `${site.url}/${segments.slice(0, i + 1).join("/")}`,
  })),
];

// Breadcrumb JSON-LD for real nested pages (skip home + Home-only trails).
if (breadcrumbItems.length > 1 && page.id !== "index") {
  schemas.push(createBreadcrumbSchema(breadcrumbItems));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="icon"
      type="image/svg+xml"
      href={siteConfig.branding.favicon.svg}
    />
    <meta name="theme-color" content={siteConfig.branding.colors.themeColor} />

    {seoSettings?.googleVerification && (
      <meta name="google-site-verification" content={seoSettings.googleVerification} />
    )}
    {seoSettings?.bingVerification && (
      <meta name="msvalidate.01" content={seoSettings.bingVerification} />
    )}

    <SEO
      title={title}
      description={description ?? business.tagline}
      image={image}
      imageAlt={imageAlt}
      article={article}
      noindex={noindex}
      nofollow={nofollow}
      businessName={business.businessName}
      canonical={canonical}
    />

    <JsonLd schema={schemas} />

    <Analytics />

    <ClientRouter />
    <script>
      // First-touch marketing attribution — persist utm_*/gclid/fbclid so any
      // later lead submission carries it (see src/lib/utm.ts + /api/lead).
      import { captureUtms } from "@/lib/utm";
      captureUtms();
      document.addEventListener("astro:page-load", captureUtms);
    </script>
    <script src="@lib/nav.js"></script>
    <script is:inline>
      // helper functions to toggle dark mode
      function enableDarkMode() {
        document.body.classList.add("dark-mode");
        localStorage.setItem("theme", "dark");
      }

      function disableDarkMode() {
        document.body.classList.remove("dark-mode");
        localStorage.setItem("theme", "light");
      }

      function setTheme() {
        // default to the light theme
        let theme = "light";

        // check localStorage for a saved 'theme' variable. if it's there, the user has visited before, so apply the necessary theme choices
        if (localStorage.getItem("theme")) {
          theme = localStorage.getItem("theme");
        }
        // if it's not there, check to see if the user has applied dark mode preferences themselves in the browser
        else if (
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          theme = "dark";
        }

        // if there is no preference set, the default of light will be used. apply accordingly
        theme === "dark" ? enableDarkMode() : disableDarkMode();
      }

      setTheme();

      document.addEventListener("astro:after-swap", setTheme); // For View Transitions purposes - astro:after-swap ensures that the theme is kept after navigating to a new page.
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-fg-on-primary focus:no-underline focus:shadow-lg"
      >Skip to content</a
    >

    <WidgetArea name="announcement-bar" class="announcement-bar" />

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />

    <ConsentBanner />
  </body>
</html>
