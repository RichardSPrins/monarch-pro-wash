---
// Page route — sourced live from EmDash (D1) under SSR. Meta tags come from
// EmDash's NATIVE SEO panel (getSeoMeta); custom JSON-LD from `structured_data`.
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import PageRenderer from "@/components/PageRenderer.astro";
import { getSeoMeta } from "emdash/seo";
import { getPage, getServiceAreas } from "@/lib/content";
import { getBusinessData, getSiteData } from "@/lib/utils";
import siteConfig from "@/config/site.config";
import { createServiceSchema, createFAQSchema } from "@/lib/schema";
import { buildTownHubSections } from "@/lib/pageTemplates";
import { hasSiaPages } from "@/config/launchScope";

const slug = Astro.params.slug ?? "index";

// Prefixed pages live under dedicated nested routes, never at the top level:
//   "svc-"  → /services/{slug}          (src/pages/services/[slug].astro)
//   "sia-"  → /{area}/{service}          (src/pages/[area]/[service].astro)
if (slug.startsWith("svc-") || slug.startsWith("sia-")) {
  return Astro.rewrite("/404");
}

const authored = await getPage(slug);
const isAuthored = Boolean(authored) && !(import.meta.env.PROD && authored!.data.demo);

// Every town in the service-areas collection gets a hub at /{town}, authored or
// not — the nav links straight here, so these must never 404.
const townArea = isAuthored
  ? null
  : (await getServiceAreas()).find((a) => a.data.slug === slug) ?? null;

if (!isAuthored && !townArea) {
  return Astro.rewrite("/404");
}

const page = isAuthored
  ? authored!
  : {
      id: slug,
      data: {
        title: `Exterior Cleaning in ${townArea!.data.city}, ${townArea!.data.state ?? "ID"} | Monarch Pro Wash`,
        sections: buildTownHubSections(townArea!, { linkToSia: hasSiaPages(slug) }),
      },
    };

// Native EmDash SEO (title/description/OG/canonical/noindex). No siteTitle passed
// so we don't double a suffix an editor/migrated title may already include.
const meta = getSeoMeta(page as any, {
  siteUrl: Astro.site?.href,
  path: Astro.url.pathname,
  defaultOgImage: siteConfig.ogImage ? new URL(siteConfig.ogImage, Astro.site).toString() : undefined,
});

// Per-page custom JSON-LD (Service / FAQPage) for bespoke SEO landing pages.
// Only an authored page can carry it; a generated town hub has none.
const sd = authored?.data?.structuredData;
const pageSchemas = [];
if (sd?.service || sd?.faq?.length) {
  const business = await getBusinessData();
  const site = getSiteData();
  if (sd.service) {
    pageSchemas.push(
      createServiceSchema(
        { ...sd.service, url: new URL(Astro.url.pathname, Astro.site).toString() },
        business,
        site,
      ),
    );
  }
  if (sd.faq?.length) pageSchemas.push(createFAQSchema(sd.faq));
}

// LocalBusiness JSON-LD is opt-OUT. This previously read `!!sd?.localBusiness`,
// which coerced a null structured_data to false and so suppressed the schema on
// every page — including the homepage, the one place a local-services site most
// needs it. Set structured_data.localBusiness = false to suppress it on a page.
const includeLocalBusiness = sd?.localBusiness ?? true;
---

<MarketingLayout
  page={page}
  title={meta.title || page.data.title}
  description={meta.description ?? undefined}
  noindex={!!meta.robots}
  image={meta.ogImage ?? undefined}
  canonical={meta.canonical ?? undefined}
  includeLocalBusinessSchema={includeLocalBusiness}
  schemas={pageSchemas}
>
  <PageRenderer config={page.data} />
</MarketingLayout>
