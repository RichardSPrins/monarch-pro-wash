---
// Category archive, pages two and up.
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogListing from "@/components/blog/BlogListing.astro";
import { getPage, getCategories } from "@/lib/blog";

const raw = decodeURIComponent(Astro.params.category ?? "");
const n = Number(Astro.params.page);
if (!Number.isInteger(n) || n < 1) return Astro.rewrite("/404");

const categories = await getCategories();
const category = categories.find((c) => c.toLowerCase() === raw.toLowerCase());
if (!category) return Astro.rewrite("/404");
if (n === 1) return Astro.redirect(`/blog/category/${encodeURIComponent(category.toLowerCase())}`, 301);

const { posts, hasMore, isEmpty } = await getPage({ page: n, category });
if (isEmpty) return Astro.rewrite("/404");

const title = `${category} articles`;
---
<BlogLayout page={{ id: `blog-cat-${category}-${n}`, data: { title } }} title={`${title}, page ${n}`}
  description={`Exterior cleaning articles filed under ${category}.`} includeLocalBusinessSchema={false}>
  <BlogListing title={title} posts={posts} page={n} hasMore={hasMore}
    categories={categories} activeCategory={category} />
</BlogLayout>
