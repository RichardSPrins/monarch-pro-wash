---
// Blog index — a card grid with covers, not a bare list of links.
//
// The old version rendered titles and dates only, and its description said
// "roofing advice from our team": wrong trade, and a team that does not exist.
import BlogLayout from "@/layouts/BlogLayout.astro";
import { Button } from "@/components/elements/button";
import { getPosts } from "@/lib/content";

const fmt = (d: Date) =>
  d && !isNaN(d.getTime())
    ? d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
    : undefined;

const posts = (await getPosts()).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Lead with whatever is marked featured, else the newest post.
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== lead);

const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))];

const page = { id: "blog", data: { title: "Exterior Cleaning Advice for the Treasure Valley" } };
const description =
  "Straight answers on pressure washing, soft washing, roofs, gutters, windows and concrete in Boise and the Treasure Valley. What things cost, when to do them, and what to watch for.";
---

<BlogLayout
  page={page}
  title="Exterior Cleaning Advice for the Treasure Valley"
  description={description}
  includeLocalBusinessSchema={false}
>
  <div class="blog-index">
    <header class="bi-head">
      <h1>Exterior Cleaning Advice for the Treasure Valley</h1>
      <p>{description}</p>
      {categories.length > 0 && (
        <ul class="cats" aria-label="Topics covered">
          {categories.map((c) => <li>{c}</li>)}
        </ul>
      )}
    </header>

    {posts.length === 0 && <p class="empty">No posts yet. Check back soon.</p>}

    {lead && (
      <a class="lead" href={`/blog/${lead.data.slug}`}>
        {lead.data.cover && (
          <img src={lead.data.cover} alt={lead.data.coverAlt ?? ""} width="1200" height="630" loading="eager" decoding="async" />
        )}
        <div class="lead-body">
          {lead.data.category && <span class="cat">{lead.data.category}</span>}
          <h2>{lead.data.title}</h2>
          {lead.data.description && <p>{lead.data.description}</p>}
          <span class="meta">{[lead.data.author, fmt(lead.data.date)].filter(Boolean).join(" · ")}</span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <ul class="grid">
        {rest.map((p) => (
          <li>
            <a href={`/blog/${p.data.slug}`}>
              {p.data.cover && (
                <img src={p.data.cover} alt={p.data.coverAlt ?? ""} width="1200" height="630" loading="lazy" decoding="async" />
              )}
              <div class="card-body">
                {p.data.category && <span class="cat sm">{p.data.category}</span>}
                <h3>{p.data.title}</h3>
                {p.data.description && <p>{p.data.description}</p>}
                <span class="meta">{fmt(p.data.date)}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <aside class="bi-cta">
      <h2>Rather just have it done?</h2>
      <p>Free quote, a clear price up front, and the owner doing the work. New customers get 10% off their first service.</p>
      <Button variant="primary" href="/contact">Get My Free Quote</Button>
    </aside>
  </div>
</BlogLayout>

<style>
  .blog-index { max-width: 72rem; margin-inline: auto; }
  .bi-head { max-width: 46rem; margin-bottom: 2.5rem; }
  .bi-head h1 { margin: 0 0 0.75rem; }
  .bi-head p { margin: 0; font-size: 1.0625rem; line-height: 1.65; color: var(--theme-fg-muted, rgba(255,255,255,0.72)); }
  .cats { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0; padding: 0; }
  .cats li {
    font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    border: 1px solid var(--theme-border, rgba(255,255,255,0.16)); border-radius: 999px; padding: 0.25rem 0.625rem;
    color: var(--theme-fg-muted, rgba(255,255,255,0.7));
  }
  .empty { color: var(--theme-fg-muted, rgba(255,255,255,0.7)); }

  .cat {
    display: inline-block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-primary);
    border: 1px solid currentColor; border-radius: 999px; padding: 0.25rem 0.625rem; margin-bottom: 0.75rem;
  }
  .cat.sm { font-size: 0.625rem; margin-bottom: 0.5rem; }

  a { text-decoration: none; color: inherit; }
  img { display: block; width: 100%; height: auto; border-radius: var(--radius-lg, 0.75rem); }

  .lead { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.75rem; align-items: center; margin-bottom: 2.5rem; }
  .lead h2 { margin: 0 0 0.625rem; font-size: 1.75rem; line-height: 1.2; }
  .lead p { margin: 0 0 0.875rem; color: var(--theme-fg-muted, rgba(255,255,255,0.72)); line-height: 1.6; }
  .lead:hover h2 { color: var(--color-primary); }
  @media (max-width: 820px) { .lead { grid-template-columns: 1fr; gap: 1rem; } }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  .card-body { padding-top: 0.875rem; }
  .grid h3 { margin: 0 0 0.5rem; font-size: 1.0625rem; line-height: 1.35; }
  .grid p {
    margin: 0 0 0.625rem; font-size: 0.9375rem; line-height: 1.55;
    color: var(--theme-fg-muted, rgba(255,255,255,0.68));
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .grid a:hover h3 { color: var(--color-primary); }

  .meta { font-size: 0.8125rem; color: var(--theme-fg-subtle, rgba(255,255,255,0.5)); }

  .bi-cta {
    margin-top: 3.5rem; padding: 2rem; text-align: center;
    border: 1px solid var(--theme-border, rgba(255,255,255,0.14));
    border-radius: var(--radius-lg, 0.75rem);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  .bi-cta h2 { margin: 0 0 0.5rem; font-size: 1.375rem; }
  .bi-cta p { margin: 0 0 1.25rem; color: var(--theme-fg-muted, rgba(255,255,255,0.75)); }
</style>
