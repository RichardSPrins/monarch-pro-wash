---
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogListing from "@/components/blog/BlogListing.astro";
import { getPage, getCategories } from "@/lib/blog";

const { lead, posts, hasMore } = await getPage({ page: 1 });
const categories = await getCategories();

const title = "Exterior Cleaning Advice for Boise and the Treasure Valley";
const description =
  "Straight answers on pressure washing, soft washing, roofs, gutters, windows and concrete. What things cost, when to do them, and what to watch out for.";
---
<BlogLayout page={{ id: "blog", data: { title } }} title={title} description={description} includeLocalBusinessSchema={false}>
  <BlogListing title={title} intro={description} posts={posts} lead={lead} page={1} hasMore={hasMore} categories={categories} />
</BlogLayout>
