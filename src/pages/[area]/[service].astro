---
// Service-in-area matrix — /{area}/{service} (e.g. /boise/roof-cleaning).
//
// Three gates, in order: the service must be PUBLISHED (launchScope), the town
// must be in SIA_AREAS, and both must be real collection entries. Anything else
// 404s. The matrix is deliberately not the full 18x13: a new domain publishing
// ~234 near-identical pages reads as doorway content, so the scope is widened
// deliberately from src/config/launchScope.ts.
//
// HYBRID content: an authored page at slug `sia-{area}--{service}` wins; the
// generated fallback below covers anything not yet authored. Either way it runs
// through PageRenderer in "rail" mode.
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { deriveDescription } from "@/lib/seoText";
import PageRenderer from "@/components/PageRenderer.astro";
import ServicePageRail from "@/components/layout/ServicePageRail.astro";
import { getServices, getServiceAreas, getPage } from "@/lib/content";
import { getSiaQuiz } from "@/lib/siaQuizzes";
import { hasSiaPages } from "@/config/launchScope";
import {
  PROCESS_STEPS,
  PROCESS_HEADINGS,
  WHY_ITEMS,
  WHY_HEADINGS,
  GUARANTEE,
  TRUST_BADGES,
  ctaBanner,
  pickVariant,
} from "@/content/copy/shared";

const areaSlug = Astro.params.area ?? "";
const serviceSlug = Astro.params.service ?? "";

// Towns outside the published matrix 404 before any data is fetched.
if (!hasSiaPages(areaSlug)) {
  return Astro.rewrite("/404");
}

// getServices() is already filtered to PUBLISHED_SERVICES, so an unpublished
// service simply won't be found here.
const [services, areas] = await Promise.all([getServices(), getServiceAreas()]);
const service = services.find((s) => s.data.slug === serviceSlug);
const area = areas.find((a) => a.data.slug === areaSlug);

if (!service || !area) {
  return Astro.rewrite("/404");
}

const city = area.data.city;
const state = area.data.state ?? "ID";
const svcTitle = service.data.title;
const svcLower = svcTitle.toLowerCase();
const desc = service.data.description ?? `Professional ${svcLower} for ${city} and the Treasure Valley.`;

// Authored content-rich page for this combo, if one exists.
const authored = await getPage(`sia-${areaSlug}--${serviceSlug}`);

// FAQs and reviews are scoped by the `topics` TERM slug, which for the matrix is
// "{area}-{service}" (e.g. "boise-pressure-washing"), not the service slug.
const faqTopic = `${areaSlug}-${serviceSlug}`;

// Tailored, service-specific qualifying quiz (from the shared quiz map).
// Capture its leads to the shared /api/lead endpoint, pre-tagged with the
// service + area so quiz leads are segmented exactly like the magnet captures.
const siaQuiz = {
  ...getSiaQuiz(serviceSlug),
  submit: {
    adapter: "webhook" as const,
    endpoint: "/api/lead",
    hiddenFields: {
      source: "magnet:sia-quiz",
      magnet: "sia-quiz",
      tags: `src:sia-quiz,svc:${serviceSlug},area:${areaSlug}`,
      service: serviceSlug,
      city: areaSlug,
    },
  },
};

// Generated fallback, shaped to the 14-section service-in-area template. The
// reserved slots (before/after, reviews) are included but will self-hide until
// there are real photos and reviews — `sectionSchemas` drops a section that
// fails validation, and reviews:cards hides itself when the query is empty.
// Section 11 (neighbourhoods) is omitted here because place names must come
// from the verified per-town research, never be generated.
const seed = `sia-${areaSlug}--${serviceSlug}`;

const fallbackSections = [
  { type: "hero:split-form", theme: "inverse", data: {
    eyebrow: { text: `${svcTitle} · ${city}, ${state}`, variant: "text" },
    heading: `${svcTitle} in ${city}, ${state}`,
    subheading: desc,
    trustBadges: [{ text: "Fully Insured" }, { text: "Owner-Operated" }, { text: "Free Quotes" }],
    showPhone: true,
    // No background image until real job photography exists. The starter's stock
    // roofing-crew photo used to sit here, on a pressure-washing site.
    form: siaQuiz,
  } },
  // Shared blocks come from src/content/copy/shared.ts. They were duplicated
  // here and in pageTemplates.ts, which is how they drifted apart.
  { type: "trust-bar:badges", theme: "alt", data: { ...TRUST_BADGES } },
  { type: "content:rich-text", theme: "alt", data: {
    eyebrow: { text: `${svcTitle} · ${city}`, variant: "text" },
    heading: `${svcTitle} for ${city} Homes and Businesses`,
    body: `<p>${desc}</p><p>Monarch brings ${svcLower} to ${city} and the surrounding Treasure Valley, with the same surface-matched method and the same owner on site for every job. Read more about our <a href="/services/${serviceSlug}">${svcLower}</a>, or see <a href="/${areaSlug}">every service we offer in ${city}</a>.</p>`,
  } },
  { type: "process:horizontal", theme: "alt", data: {
    eyebrow: { text: "The Process", variant: "text" },
    heading: pickVariant(seed, PROCESS_HEADINGS),
    steps: PROCESS_STEPS.map((s) => ({ ...s })),
  } },
  { type: "about:values", theme: "default", data: {
    eyebrow: { text: "Why Monarch", variant: "text" },
    heading: `Why ${city} Property Owners Choose Monarch`,
    items: WHY_ITEMS.map((i) => ({ ...i })),
  } },
  // No gallery:before-after here. With no pairs it fails validation, which is a
  // loud error shim in dev and nothing at all in production.
  { type: "reviews:cards", theme: "alt", data: {
    eyebrow: { text: "Reviews", variant: "text" },
    heading: `What ${city} Customers Say`,
    filter: "all",
    area: city,
    limit: 3,
  } },
  { type: "guarantee:callout", theme: "brand-secondary", data: { ...GUARANTEE } },
  { type: "faqs:accordion", theme: "alt", data: {
    eyebrow: { text: "FAQs", variant: "text" },
    heading: `${svcTitle} in ${city}: Common Questions`,
    service: faqTopic,
  } },
  { type: "services:grid", theme: "alt", data: {
    eyebrow: { text: "More Services", variant: "text" },
    heading: `Our Other Services in ${city}`,
    subheading: "Most properties need more than one thing cleaned. We handle it in a single visit.",
    hrefBase: `/${areaSlug}`,
  } },
  { type: "service-areas:chips", theme: "muted", data: {
    eyebrow: { text: "Service Areas", variant: "text" },
    heading: "Serving the Treasure Valley",
  } },
  { type: "cta:banner", theme: "primary", data: ctaBanner(seed, {
    heading: `Ready for ${svcTitle} in ${city}?`,
  }) },
];

const rawSections = authored?.data?.sections?.length ? authored.data.sections : fallbackSections;
const title = authored?.data?.title ?? `${svcTitle} in ${city}, ${state} | Monarch Pro Wash`;

// Inject the service-tailored quiz into the hero, overriding whatever an authored
// page stored — so the quiz is code-driven and consistent across every combo.
const sections = rawSections.map((s: any) =>
  s?.type === "hero:split-form" ? { ...s, data: { ...s.data, form: siaQuiz } } : s,
);

const page = {
  id: `${areaSlug}/${serviceSlug}`,
  data: { title, sections },
};
---

<MarketingLayout
  page={page}
  title={page.data.title}
  description={deriveDescription(sections) ?? `${svcTitle} in ${city}, ${state}. ${desc}`}
>
  <PageRenderer config={page.data} layout="rail">
    <ServicePageRail
      slot="rail"
      areaSlug={areaSlug}
      areaName={city}
      currentService={serviceSlug}
    />
  </PageRenderer>
</MarketingLayout>
