  .est-slider {
    margin-top: 1.1rem;
  }
  .est-slider-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.35rem;
  }
  .est-slider-head label {
    font-weight: 600;
    color: var(--color-fg);
    font-size: 0.92rem;
  }
  .est-slider-head output {
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .est-slider input[type="range"] {
    width: 100%;
    accent-color: var(--color-primary);
    height: 1.5rem;
