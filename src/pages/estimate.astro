    color: var(--color-fg-muted);
    margin: 0;
  }
  .est-amount {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
    margin: 0.25rem 0 0.5rem;
    min-height: 2.5rem;
  }
  .est-amount[data-locked="1"] .est-amount-locked {
    color: color-mix(in srgb, var(--color-fg) 45%, transparent);
    letter-spacing: 0.02em;
  }
  .est-result-note {
    font-size: 0.9rem;
    color: var(--color-fg-muted);
    margin: 0 0 1rem;
  }

  .est-gate {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .est-gate-copy {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-fg);
    margin: 0;
  }
  .est-gate input[type="text"],
  .est-gate input[type="tel"],
  .est-gate input[type="email"],
  .est-gate select {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--card);
    color: var(--color-fg);
    font-size: 0.95rem;
  }
  .est-gate-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-fg-muted);
    margin: 0.15rem 0 -0.35rem;
  }
  .est-gate input::placeholder {
    color: var(--color-fg-subtle);
  }
  .est-gate input:focus,
  .est-gate input:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }
  .est-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .est-cta {
    display: inline-block;
    text-align: center;
    text-decoration: none;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    border: 0;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .est-cta:hover {
    opacity: 0.9;
  }
  .est-cta-alt {
    display: block;
    text-align: center;
    text-decoration: none;
    color: var(--color-fg);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  .est-fine,
  .est-disclaimer {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin: 0;
  }
  .est-disclaimer {
    text-align: center;
    padding: 0 0.5rem;
  }
  .est-error {
    font-size: 0.85rem;
    color: var(--color-error, #dc2626);
    margin: 0;
  }
  .est-convert {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .est-convert-copy {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-fg);
    margin: 0 0 0.5rem;
  }
</style>

<script>
  import { submitForm } from "@/lib/forms/submitForm";

  // Measure the sticky site header so the sticky result card clears it. No
  // --header-height token exists in the system, and header height varies by
  // variant, so we measure the rendered <header> and expose it as --header-h.
  function setHeaderOffset() {
    const h = document.querySelector("header");
    if (h)
      document.documentElement.style.setProperty(
        "--header-h",
        h.offsetHeight + "px",
      );
  }
  window.addEventListener("resize", setHeaderOffset);

  type ServicePricing = {
    base: [number, number];
    size: boolean;
    story: boolean;
    panels?: boolean;
  };
  type Pricing = {
    services: Record<string, ServicePricing>;
    solar: { perPanel: [number, number]; min: [number, number] };
    sizeMult: { min: number; max: number; sqftMin: number; sqftMax: number };
    storyMult: { one: number; two: number; three: number };
    commercialMult: number;
    roundTo: number;
  };

  function init() {
    const root = document.getElementById("estimator");
    if (!root || (root as any).__wired) return;
    (root as any).__wired = true;

    // Pricing model injected server-side from src/config/estimatorPricing.ts
    // (or, later, a CMS singleton). All figures live there, not here.
    let P: Pricing;
    try {
      P = JSON.parse(root.querySelector("#est-pricing")?.textContent || "{}");
    } catch {
      return;
    }
    if (!P.services) return;

    const state = {
      services: new Set<string>(),
      other: false,
      prop: "residential",
      size: 2400,
      stories: 1,
      panels: 16,
      town: "",
      when: "asap",
      revealed: false,
    };

    const $ = (s: string) => root.querySelector(s) as HTMLElement | null;
    const amountEl = $("#est-amount")!;
    const amountVal = $(".est-amount-value") as HTMLElement;
    const amountLocked = $(".est-amount-locked") as HTMLElement;
    const noteEl = $("#est-result-note")!;
    const gate = $("#est-gate") as HTMLFormElement;
    const convert = $("#est-convert")!;
    const panelsWrap = $("#est-panels-wrap")!;
    const storyWrap = root.querySelector("[data-story-wrap]") as HTMLElement;

    const round = (n: number) => Math.round(n / P.roundTo) * P.roundTo;
    const money = (n: number) => "$" + round(n).toLocaleString();

    function compute() {
      const sm = P.sizeMult;
      const sizeMult =
        sm.min +
        ((state.size - sm.sqftMin) / (sm.sqftMax - sm.sqftMin)) *
          (sm.max - sm.min);
      const storyMult =
        state.stories === 3
          ? P.storyMult.three
          : state.stories === 2
            ? P.storyMult.two
            : P.storyMult.one;
      let lo = 0,
        hi = 0;
      for (const slug of state.services) {
        const m = P.services[slug];
        if (!m) continue;
        if (m.panels) {
          lo += Math.max(P.solar.min[0], state.panels * P.solar.perPanel[0]);
          hi += Math.max(P.solar.min[1], state.panels * P.solar.perPanel[1]);
          continue;
        }
        let bl = m.base[0],
          bh = m.base[1];
        if (m.size) {
          bl *= sizeMult;
          bh *= sizeMult;
        }
        if (m.story) {
          bl *= storyMult;
          bh *= storyMult;
        }
        lo += bl;
        hi += bh;
      }
      if (state.prop === "commercial") {
        lo *= P.commercialMult;
        hi *= P.commercialMult;
      }
      return { lo, hi };
    }

    function temp() {
      return state.when === "asap" ? "hot" : "warm";
    }

    function refresh() {
      // panels slider only when a per-panel (solar) service is selected
      panelsWrap.hidden = ![...state.services].some(
        (s) => P.services[s]?.panels,
      );
      // stories slider irrelevant if no selected service scales with stories
      const needsStories = [...state.services].some(
        (s) => P.services[s]?.story,
      );
      storyWrap.style.display = needsStories ? "" : "none";

      const count = state.services.size + (state.other ? 1 : 0);
      if (count === 0) {
        noteEl.textContent = "Pick a service to start your estimate.";
        gate.hidden = true;
        return;
      }

      const { lo, hi } = compute();
      if (!state.revealed) {
        gate.hidden = false;
        amountEl.dataset.locked = "1";
        amountLocked.hidden = false;
        amountVal.hidden = true;
        noteEl.textContent = state.other
          ? "Estimate ready. Your extra request is quoted on-site."
          : "Estimate ready — reveal it below.";
      } else {
        amountVal.textContent = `${money(lo)}–${money(hi)}`;
        noteEl.textContent = state.other
          ? "Your extra request is quoted on-site."
          : `Based on ${count} service${count > 1 ? "s" : ""} for your property.`;
      }
    }

    // Services
    root.querySelectorAll<HTMLButtonElement>(".est-service").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.dataset.service!;
        if (state.services.has(slug)) {
          state.services.delete(slug);
          btn.setAttribute("aria-pressed", "false");
        } else {
          state.services.add(slug);
          btn.setAttribute("aria-pressed", "true");
        }
        refresh();
      });
    });
    ($("#est-other") as HTMLInputElement).addEventListener("change", (e) => {
      state.other = (e.target as HTMLInputElement).checked;
      refresh();
    });

    // Property toggles
    root.querySelectorAll<HTMLButtonElement>("[data-prop]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root
          .querySelectorAll("[data-prop]")
          .forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        state.prop = btn.dataset.prop!;
        refresh();
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-when]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root
          .querySelectorAll("[data-when]")
          .forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        state.when = btn.dataset.when!;
      });
    });

    // Sliders
    const sizeIn = $("#est-size") as HTMLInputElement;
    const sizeOut = $("#est-size-out")!;
    sizeIn.addEventListener("input", () => {
      state.size = +sizeIn.value;
      sizeOut.textContent = `~${state.size.toLocaleString()} sq ft`;
      refresh();
    });
    const storiesIn = $("#est-stories") as HTMLInputElement;
    const storiesOut = $("#est-stories-out")!;
    storiesIn.addEventListener("input", () => {
      state.stories = +storiesIn.value;
      storiesOut.textContent =
        state.stories === 3
          ? "3+ stories"
          : `${state.stories} stor${state.stories > 1 ? "ies" : "y"}`;
      refresh();
    });
    const panelsIn = $("#est-panels") as HTMLInputElement;
    const panelsOut = $("#est-panels-out")!;
    panelsIn.addEventListener("input", () => {
      state.panels = +panelsIn.value;
      panelsOut.textContent = `${state.panels} panels`;
      refresh();
    });
    ($("#est-town") as HTMLSelectElement).addEventListener("change", (e) => {
      state.town = (e.target as HTMLSelectElement).value;
    });

    setHeaderOffset();

    // Gate submit → capture → reveal
    gate.addEventListener("submit", async (e) => {
      e.preventDefault();
      const errorEl = gate.querySelector(".est-error") as HTMLElement;
      errorEl.hidden = true;
      const btn = gate.querySelector(
        "button[type=submit]",
      ) as HTMLButtonElement;
      const orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = "Revealing…";

      const { lo, hi } = compute();
      const services = [...state.services];
      const tags = [
        "src:price-estimator",
        ...services.map((s) => "svc:" + s),
        state.town && state.town !== "other" ? "area:" + state.town : "",
        "prop:" + state.prop,
        "interest:estimate",
        "temp:" + temp(),
        state.services.size >= 2 ? "flag:multi-service" : "",
        hi >= 1000 ? "flag:high-value" : "",
      ].filter(Boolean);

      const fd = new FormData(gate);
      const payload: Record<string, unknown> = {
        magnet: "price-estimator",
        source: "magnet:price-estimator",
        tags,
        page: "/estimate",
        name: fd.get("name"),
        phone: fd.get("phone"),
        email: fd.get("email"),
        companyWebsite: fd.get("companyWebsite"),
        contactTime: fd.get("contactTime"),
        notes: fd.get("notes"),
        // answers
        services: services.join(","),
        otherRequest: state.other,
        propertyType: state.prop,
        homeSqft: state.size,
        stories: state.stories,
        solarPanels: state.services.has("solar-panel-cleaning")
          ? state.panels
          : null,
        city: state.town,
        timeline: state.when,
        estimateLow: round(lo),
        estimateHigh: round(hi),
      };

      const res = await submitForm(
        payload,
        {
          adapter: "webhook",
          endpoint: "/api/lead",
          formName: "magnet:price-estimator",
        },
        root,
      );

      if (res.ok) {
        state.revealed = true;
        amountEl.dataset.locked = "0";
        amountLocked.hidden = true;
        amountVal.hidden = false;
        gate.hidden = true;
        convert.hidden = false;
        refresh();
        amountEl.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        btn.disabled = false;
        btn.textContent = orig || "Reveal My Estimate →";
        errorEl.hidden = false;
      }
    });

    refresh();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
