---
/**
 * /sections/[type] — renders ONE section variant with its example data, plus a
 * sticky bar showing the type + data shape. Isolated preview: a section that
 * throws at runtime only breaks its own page, never the whole catalog. noindex.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageRenderer from "@/components/PageRenderer.astro";
import { sectionRegistry } from "@/lib/sectionRegistry";
import templatesRaw from "../../../plugins/section-builder/schema/templates.json";

const templates = templatesRaw as Record<string, Record<string, unknown>>;
const slug = Astro.params.slug ?? "";
const type = slug.replace("__", ":");
const data = templates[type];
const exists = !!sectionRegistry[type] && !!data;
---

<BaseLayout title={`${type} — Section Preview`} description={`Live preview of the ${type} section.`} noindex page={{ id: `sections/${slug}`, data: {} }}>
  {
    exists ? (
      <>
        <div class="preview-bar">
          <a href="/sections">← Catalog</a>
          <code>{type}</code>
          <details>
            <summary>data shape</summary>
            <pre>{JSON.stringify(data, null, 2)}</pre>
          </details>
        </div>
        <PageRenderer config={{ sections: [{ type, theme: "default", data }] }} />
      </>
    ) : (
      <div class="preview-missing">
        <a href="/sections">← Catalog</a>
        <p>Unknown section: <code>{type}</code></p>
      </div>
    )
  }
</BaseLayout>

<style>
  .preview-bar {
    position: sticky; top: 0; z-index: 50; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
    padding: 0.5rem 1.5rem; background: #0a1f2e; color: #e7eef2; font-size: 0.8rem;
  }
  .preview-bar > a { color: #f0764a; text-decoration: none; font-weight: 600; }
  .preview-bar code { font-weight: 700; color: #f0764a; }
  .preview-bar details { position: relative; }
  .preview-bar summary { cursor: pointer; color: #9fb3c0; user-select: none; }
  .preview-bar pre {
    position: absolute; left: 0; top: 100%; margin: 0.4rem 0 0; min-width: 22rem; max-height: 24rem; overflow: auto;
    background: #06121c; color: #cfe0ea; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.72rem; line-height: 1.5; white-space: pre;
  }
  .preview-missing { padding: 4rem 1.5rem; }
  .preview-missing a { color: var(--color-primary); text-decoration: none; }
</style>
