{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"name": "monarch-pro-wash",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "monarch-pro-wash-db",
			"database_id": "f71d7cb9-27fa-4d60-9479-410bb232793f",
			"remote": false,
			"migrations_dir": "../../migrations"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "monarch-pro-wash-media",
			"binding": "MEDIA",
			"remote": false
		}
	],
	"kv_namespaces": [{ "binding": "SESSION", "id": "fb0b1a901a5e46eab98b025214455965" }]
}
